{% liquid
    assign enable_burger_menu = false
    assign new_in_menu = linklists['new-in']
    for block in section.blocks
        if block.type == 'burger_menu'
            assign enable_burger_menu = true
        endif
    endfor
%}


{%- if section.settings.menu != blank or enable_burger_menu -%}
    {% render 'header-drawer' %}
{%- endif -%}

<div class='menu_left_block'>
    {% render 'desktop-burger-menu' %}

    <nav class='header__inline-menu'>
        {%- if section.settings.menu != blank -%}
            <ul class='list-menu list-menu--inline' role='list'>
                {%- for link in section.settings.menu.links -%}
                    {% liquid
                        assign mega_menu = false
                        assign mega_menu_list = false
                        assign mega_menu_blocks = false
                    %}
                    
                    {%- comment -%} VERIFICA SE O LINK TEM SUBMENU NATIVO DO SHOPIFY {%- endcomment -%}
                    {%- if link.links != blank -%}
                        {% if section.blocks.size > 0 %}
                            {% for block in section.blocks %}
                                {% liquid
                                    assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip
                                    assign mega_menu_list_trigger = block.settings.mega_menu_list_trigger | handle | strip
                                    assign mega_menu_blocks_trigger = block.settings.mega_menu_blocks_trigger | handle | strip

                                    if link.handle == mega_menu_trigger
                                        assign mega_menu = true
                                        assign mega_menu_list = false
                                        assign mega_menu_blocks = false
                                        assign shopify_attributes = block.shopify_attributes
                                    elsif link.handle == mega_menu_list_trigger
                                        assign mega_menu_list = true
                                        assign mega_menu = false
                                        assign mega_menu_blocks = false
                                        assign shopify_attributes = block.shopify_attributes
                                    elsif link.handle == mega_menu_blocks_trigger
                                        assign mega_menu_blocks = true
                                        assign mega_menu_list = false
                                        assign mega_menu = false
                                        assign shopify_attributes = block.shopify_attributes
                                    endif
                                %}
                            {% endfor %}
                        {% endif %}
                        <li class='list-menu-item {% if mega_menu or mega_menu_blocks or mega_menu_list %}list-menu--megamenu {% else %}list-menu--submenu{% endif %}' {{ shopify_attributes }}>
                            {% if mega_menu %}
                                {% render 'mega-menu', link: link, blocks: section.blocks %}
                            {% endif %}
                            <a href='{{ link.url }}' class='header__menu-item list-menu__item link focus-inset {%- if link.active %} header__active-menu-item{% endif %}' {% if link.current %} aria-current='page' {% endif %} aria-label='{{ link.title | escape }}'>
                                <span class='list-menu-line link-hover-line' title='{{ link.title | escape }}'>
                                    {{ link.title | escape }}
                                </span>
                            </a>
                            {% if mega_menu == false %}
                                {% render 'submenu', link: link %}
                            {% endif %}
                        </li>
                    
                    {%- comment -%} SE NÃO TEM SUBMENU NATIVO, RENDERIZA COMO LINK SIMPLES (E INJETA O MENU SUSPENSO NO INÍCIO) {%- endcomment -%}
                    {%- else -%}
                        {% liquid 
                            assign is_inicio = false
                            if link.title == 'INÍCIO' or link.title == 'Início' or link.title == 'Home'
                                assign is_inicio = true
                            endif 
                        %}
                        
                        <li class='list-menu-item {% if is_inicio and new_in_menu != blank %}list-menu--submenu list-menu--new-in{% endif %}'>
                            <a href='{{ link.url }}' class='header__menu-item list-menu__item link focus-inset {%- if link.active %} header__active-menu-item{% endif %}' {% if link.current %} aria-current='page' {% endif %} aria-label='{{ link.title | escape }}'>
                                <span class='list-menu-line link-hover-line' title='{{ link.title | escape }}'>
                                    {{ link.title | escape }}
                                </span>
                            </a>
                            
                            {%- comment -%} INJETA O MENU DE CATEGORIAS GLOBAIS APENAS NO BOTÃO INÍCIO {%- endcomment -%}
                            {%- if is_inicio and new_in_menu != blank -%}
                                <div class="header__submenu new-in-submenu">
                                    <ul class="list-menu" role="list">
                                        <li class="list-menu-item">
                                            <a class="list-menu__item link focus-inset" href="/collections/all">
                                                <span class="list-menu-line link-hover-line">VER TUDO</span>
                                            </a>
                                        </li>
                                        {%- assign base_links = new_in_menu.links -%}
                                        {%- if new_in_menu.links.size == 1 and new_in_menu.links[0].links != blank -%}
                                            {%- assign base_links = new_in_menu.links[0].links -%}
                                        {%- endif -%}

                                        {%- for l1 in base_links -%}
                                            <li class="list-menu-item new-in-group">
                                                <span class="new-in-title">{{ l1.title | escape }}</span>
                                                {%- if l1.links != blank -%}
                                                    <ul class="list-menu new-in-children" role="list">
                                                        {%- for l2 in l1.links -%}
                                                            <li class="list-menu-item">
                                                                <a class="list-menu__item link focus-inset" href="{{ l2.url }}">
                                                                    <span class="list-menu-line link-hover-line">{{ l2.title | escape }}</span>
                                                                </a>
                                                            </li>
                                                        {%- endfor -%}
                                                    </ul>
                                                {%- endif -%}
                                            </li>
                                        {%- endfor -%}
                                    </ul>
                                </div>
                            {%- endif -%}
                        </li>
                    {%- endif -%}
                {%- endfor -%}

                {%- comment -%} BOTÃO NEW IN FIXO (LIMPO E APONTANDO PARA A COLEÇÃO NOVA) {%- endcomment -%}

            </ul>
        {%- endif -%}
    </nav>
</div>

{% render 'header-logo', tag: 'h1' %}

<div class='header__column'>
    <div class='header__icons'>
        {% render 'header-region', section: section %}

        {%- if section.settings.scheme_position == 'right' -%}
            {% render 'color-scheme' %}
        {%- endif -%}

        <div class='header__right--part'>
            {%- if section.settings.enable_search -%}
                {% if request.page_type != 'search' %}
                    <div class='header__search header__icons--hover{% if section.settings.search_button_type == 'icon' %} only_icon{% elsif section.settings.search_button_type == 'text' %} only_text{% endif %}{% if section.settings.search_mobile_button_type == 'icon' %} mobile_only_icon{% elsif section.settings.search_mobile_button_type == 'text' %} mobile_only_text{% endif %}'>
                        <div class='header__icon header__icon--search link--text  header__icon--summary focus-inset modal__toggle header__icons--container' aria-haspopup='dialog' role='button' id='search-icon-open'>
                            {% render 'icon-search' %}
                            <span class='link-hover-line search-name'>{{- 'sections.header.search' | t -}}</span>
                        </div>
                    </div>
                {% else %}
                    <div class='header__search header__icons--hover{% if section.settings.search_button_type == 'icon' %} only_icon{% elsif section.settings.search_button_type == 'text' %} only_text{% endif %}{% if section.settings.search_mobile_button_type == 'icon' %} mobile_only_icon{% elsif section.settings.search_mobile_button_type == 'text' %} mobile_only_text{% endif %}'>
                        <a href='{{ routes.search_url }}' class='header__icon header__icon--search focus-inset header__icons--container' title='{{ 'general.search.search' | t }}' aria-label='{{ 'general.search.search' | t }}'>
                            {% render 'icon-search' %}
                            <span class='link-hover-line search-name'>{{- 'sections.header.search' | t -}}</span>
                        </a>
                    </div>
                {% endif %}
            {%- endif -%}

            {%- if shop.customer_accounts_enabled -%}
                <div class='header__account header__icons--hover{% if section.settings.account_button_type == 'icon' %} only_icon{% endif %}'>
                    {%- if request.page_type != 'customers/account' and settings.account_type == 'drawer' -%}
                        <details>
                            <summary class='header__icon header__icon--account link--text header__icon--summary focus-inset modal__toggle header__icons--container' aria-haspopup='dialog' id='account-icon-open'>
                                {%- if section.settings.account_button_type == 'icon' or section.settings.account_button_type == 'icon-and-text' -%}
                                    {% render 'icon-account' %}
                                {% endif %}
                                {%- if section.settings.account_button_type == 'text' or section.settings.account_button_type == 'icon-and-text' -%}
                                    <span class='link-hover-line'>{{- 'sections.header.account' | t -}}</span>
                                {% endif %}
                            </summary>
                        </details>
                    {%- else -%}
                        <a class='header__icon header__icon-link header__icon--account link--text  header__icon--summary focus-inset modal__toggle' href='{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}'>
                            {%- if section.settings.account_button_type == 'icon' or section.settings.account_button_type == 'icon-and-text' -%}
                                {% render 'icon-account' %}
                            {% endif %}
                            {%- if section.settings.account_button_type == 'text' or section.settings.account_button_type == 'icon-and-text' -%}
                                <span class='link-hover-line'>{{- 'sections.header.account' | t -}}</span>
                            {% endif %}
                        </a>
                    {%- endif -%}
                </div>
            {%- endif -%}

            <div class='header__cart header__icons--hover{% if request.page_type == 'cart' %} header__cart--page{% endif %}{% if section.settings.cart_button_type == 'text' %} only_text{%  elsif  section.settings.cart_button_type == 'icon' %} only_icon{% endif %}{%if section.settings.cart_mobile_button_type == 'text' %} mobile_only_text{%  elsif  section.settings.cart_mobile_button_type == 'icon' %} mobile_only_icon{% endif %}'>
                <a href='{{ routes.cart_url }}' class=' header__icon header__icon--cart link link--text focus-inset header__icons--container' id='cart-icon-bubble'>
                    {% render 'icon-cart' %}
                    <div class='header__cart--text link-hover-line header__icon--cart'>
                        <span class='text-cart'>{{ 'sections.header.cart' | t }}</span>
                        <span class='visually-hidden'>{{ 'templates.cart.cart' | t }}</span>
                        <div class='cart-count-bubble'>
                            {%- if cart.item_count < 100 -%}
                                <span aria-hidden='true'>({{ cart.item_count }})</span>
                            {%- endif -%}
                            <span class='visually-hidden'>{{- 'sections.header.cart_count' | t: count: cart.item_count -}}</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>