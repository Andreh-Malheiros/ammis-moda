{% liquid
  assign enable_burger_menu = false
  assign burger_block = nil

  for block in section.blocks
    if block.type == 'burger_menu'
      assign enable_burger_menu = true
      assign burger_block = block
      break
    endif
  endfor

  assign mobile_menu = section.settings.menu
  if enable_burger_menu and burger_block.settings.main_menu != blank
    assign mobile_menu = burger_block.settings.main_menu
  endif
%}

<header-drawer data-breakpoint="tablet">
  <details class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link--text focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {% render 'icon-hamburger' %}
        <span class="header__modal-close-button">
          {% render 'icon-close' %}
        </span>
      </span>
    </summary>

    <div id="menu-drawer" class="menu-drawer motion-reduce color-background-1" tabindex="-1">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">

          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="menu-drawer__menu list-menu ammis-mobile-menu" role="list">
              {%- for link in mobile_menu.links -%}
                {%- liquid
                  assign is_group_heading = false
                  if link.links != blank
                    if link.url == blank or link.url == '#' or link.url contains 'javascript:void'
                      assign is_group_heading = true
                    endif
                  endif
                -%}

                {%- if is_group_heading -%}
                  <li class="ammis-mobile-menu__section">
                    <div class="ammis-mobile-menu__section-title">
                      {{ link.title | escape }}
                    </div>

                    <ul class="ammis-mobile-menu__section-list list-menu" role="list">
                      {%- for childlink in link.links -%}
                        <li class="ammis-mobile-menu__row">
                          {%- if childlink.links != blank -%}
                            <details class="ammis-mobile-menu__details">
                              <summary class="menu-drawer__menu-item ammis-mobile-menu__item list-menu__item link--text focus-inset{% if childlink.child_active %} menu-drawer__menu-item--active{% endif %}">
                                <span>{{ childlink.title | escape }}</span>
                                {% render 'icon-caret' %}
                              </summary>

                              <div
                                id="childlink-{{ link.handle }}-{{ childlink.handle }}"
                                class="menu-drawer__submenu motion-reduce"
                                tabindex="-1"
                              >
                                <div class="menu-drawer__inner-submenu">
                                  <button
                                    type="button"
                                    class="menu-drawer__close-button ammis-mobile-menu__back link link--text focus-inset"
                                    aria-expanded="true"
                                  >
                                    {% render 'icon-arrow' %}
                                    <span>{{ childlink.title | escape }}</span>
                                  </button>

                                  {%- if childlink.url != blank and childlink.url != '#' -%}
                                    <a
                                      href="{{ childlink.url }}"
                                      class="ammis-mobile-menu__view-all link focus-inset"
                                    >
                                      Ver todos
                                    </a>
                                  {%- endif -%}

                                  <ul class="menu-drawer__menu list-menu ammis-mobile-menu__submenu-list" role="list">
                                    {%- for grandchildlink in childlink.links -%}
                                      <li>
                                        <a
                                          href="{{ grandchildlink.url }}"
                                          class="menu-drawer__menu-item ammis-mobile-menu__submenu-item link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                          {% if grandchildlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {{ grandchildlink.title | escape }}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              </div>
                            </details>
                          {%- else -%}
                            <a
                              href="{{ childlink.url }}"
                              class="menu-drawer__menu-item ammis-mobile-menu__item list-menu__item link--text focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              <span>{{ childlink.title | escape }}</span>
                            </a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </li>

                {%- else -%}
                  <li class="ammis-mobile-menu__row">
                    {%- if link.links != blank -%}
                      <details class="ammis-mobile-menu__details">
                        <summary class="menu-drawer__menu-item ammis-mobile-menu__item list-menu__item link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                          <span>{{ link.title | escape }}</span>
                          {% render 'icon-caret' %}
                        </summary>

                        <div
                          id="link-{{ link.handle }}"
                          class="menu-drawer__submenu motion-reduce"
                          tabindex="-1"
                        >
                          <div class="menu-drawer__inner-submenu">
                            <button
                              type="button"
                              class="menu-drawer__close-button ammis-mobile-menu__back link link--text focus-inset"
                              aria-expanded="true"
                            >
                              {% render 'icon-arrow' %}
                              <span>{{ link.title | escape }}</span>
                            </button>

                            {%- if link.url != blank and link.url != '#' -%}
                              <a
                                href="{{ link.url }}"
                                class="ammis-mobile-menu__view-all link focus-inset"
                              >
                                Ver todos
                              </a>
                            {%- endif -%}

                            <ul class="menu-drawer__menu list-menu ammis-mobile-menu__submenu-list" role="list">
                              {%- for childlink in link.links -%}
                                <li>
                                  {%- if childlink.links != blank -%}
                                    <details class="ammis-mobile-menu__details">
                                      <summary class="menu-drawer__menu-item ammis-mobile-menu__submenu-item list-menu__item link--text focus-inset{% if childlink.child_active %} menu-drawer__menu-item--active{% endif %}">
                                        <span>{{ childlink.title | escape }}</span>
                                        {% render 'icon-caret' %}
                                      </summary>

                                      <div
                                        id="childlink-{{ link.handle }}-{{ childlink.handle }}"
                                        class="menu-drawer__submenu motion-reduce"
                                        tabindex="-1"
                                      >
                                        <div class="menu-drawer__inner-submenu">
                                          <button
                                            type="button"
                                            class="menu-drawer__close-button ammis-mobile-menu__back link link--text focus-inset"
                                            aria-expanded="true"
                                          >
                                            {% render 'icon-arrow' %}
                                            <span>{{ childlink.title | escape }}</span>
                                          </button>

                                          {%- if childlink.url != blank and childlink.url != '#' -%}
                                            <a
                                              href="{{ childlink.url }}"
                                              class="ammis-mobile-menu__view-all link focus-inset"
                                            >
                                              Ver todos
                                            </a>
                                          {%- endif -%}

                                          <ul class="menu-drawer__menu list-menu ammis-mobile-menu__submenu-list" role="list">
                                            {%- for grandchildlink in childlink.links -%}
                                              <li>
                                                <a
                                                  href="{{ grandchildlink.url }}"
                                                  class="menu-drawer__menu-item ammis-mobile-menu__submenu-item link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                                  {% if grandchildlink.current %}
                                                    aria-current="page"
                                                  {% endif %}
                                                >
                                                  {{ grandchildlink.title | escape }}
                                                </a>
                                              </li>
                                            {%- endfor -%}
                                          </ul>
                                        </div>
                                      </div>
                                    </details>
                                  {%- else -%}
                                    <a
                                      href="{{ childlink.url }}"
                                      class="menu-drawer__menu-item ammis-mobile-menu__submenu-item link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                      {% if childlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{ childlink.title | escape }}
                                    </a>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- else -%}
                      <a
                        href="{{ link.url }}"
                        class="menu-drawer__menu-item ammis-mobile-menu__item list-menu__item link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        <span>{{ link.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {% if section.settings.mobile_menu_promo_enabled %}
              {% if section.settings.mobile_menu_promo_image != blank
                or section.settings.mobile_menu_promo_title != blank
                or section.settings.mobile_menu_promo_text != blank
              %}
                <div class="ammis-mobile-menu__promo">
                  {%- if section.settings.mobile_menu_promo_link != blank -%}
                    <a
                      href="{{ section.settings.mobile_menu_promo_link }}"
                      class="ammis-mobile-menu__promo-link focus-inset"
                      aria-label="{{ section.settings.mobile_menu_promo_title | default: section.settings.mobile_menu_promo_label | escape }}"
                    >
                  {%- endif -%}

                  <div class="ammis-mobile-menu__promo-content">
                    {% if section.settings.mobile_menu_promo_title != blank %}
                      <p class="ammis-mobile-menu__promo-title">
                        {{ section.settings.mobile_menu_promo_title | escape }}
                      </p>
                    {% endif %}

                    {% if section.settings.mobile_menu_promo_text != blank %}
                      <p class="ammis-mobile-menu__promo-text">
                        {{ section.settings.mobile_menu_promo_text | escape }}
                      </p>
                    {% endif %}

                    {% if section.settings.mobile_menu_promo_label != blank %}
                      <span class="ammis-mobile-menu__promo-cta">
                        {{ section.settings.mobile_menu_promo_label | escape }}
                        <span aria-hidden="true">→</span>
                      </span>
                    {% endif %}
                  </div>

                  {% if section.settings.mobile_menu_promo_image != blank %}
                    <div class="ammis-mobile-menu__promo-media">
                      {{
                        section.settings.mobile_menu_promo_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '320, 480, 640, 900',
                          sizes: '(max-width: 749px) 48vw, 1px',
                          class: 'ammis-mobile-menu__promo-image',
                          alt: section.settings.mobile_menu_promo_image.alt
                      }}
                    </div>
                  {% endif %}

                  {%- if section.settings.mobile_menu_promo_link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {% endif %}
            {% endif %}
          </nav>

          <div class="menu-drawer__utility-links{% if customer %} menu-drawer__utility-links-customer{% endif %}">
            {%- if shop.customer_accounts_enabled -%}
              {%- if customer -%}
                <div class="menu-drawer__utility-account">
                  <div class="menu-drawer__utility-account-header">
                    <h3 class="menu-drawer__utility-name">{{ customer.name }}</h3>
                  </div>

                  <ul class="menu-drawer__utility-account-body">
                    <li class="menu-drawer__utility-account-link">
                      <a href="{{ routes.account_url }}" class="link button button--simple">
                        <span>{{ 'customer.account_fallback' | t }}</span>
                      </a>
                    </li>
                    <li class="menu-drawer__utility-account-address">
                      <a href="{{ routes.account_addresses_url }}" class="link button button--simple">
                        <span>{{ 'customer.addresses.book' | t }}</span>
                      </a>
                    </li>
                  </ul>

                  <a
                    class="header__account__logout button button--tertiary focus-inset"
                    href="{{ routes.account_logout_url }}"
                  >
                    <span>{{ 'customer.log_out' | t }}</span>
                  </a>
                </div>
              {%- else -%}
                <a
                  href="{{ routes.account_login_url }}"
                  class="button button--tertiary menu-drawer__account link focus-inset"
                >
                  <span>{{ 'customer.log_in' | t }}</span>
                </a>

                {% if settings.enable_create_account %}
                  <div class="menu-drawer__account-register">
                    <a href="{{ routes.account_register_url }}" class="link button button--simple">
                      <span>{{ 'customer.login_page.create_account' | t }}</span>
                    </a>
                  </div>
                {% endif %}
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="menu-drawer__bottom">
            {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
              <div class="menu-drawer__localization-wrapper">
                {% render 'header-region', section: section %}
              </div>
            {%- endif -%}
            {% render 'color-scheme' %}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
