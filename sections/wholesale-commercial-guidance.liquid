<section id="curadoria-ammis" class="wholesale-commercial-guidance">
  <div class="wholesale-commercial-guidance__inner">
    <header class="wholesale-commercial-guidance__header">
      {% if section.settings.eyebrow != blank %}
        <p class="wholesale-commercial-guidance__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="wholesale-commercial-guidance__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="wholesale-commercial-guidance__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="wholesale-commercial-guidance__grid">
        {% for block in section.blocks %}
          <article class="wholesale-commercial-guidance__item" {{ block.shopify_attributes }}>
            <span class="wholesale-commercial-guidance__index" aria-hidden="true">0{{ forloop.index }}</span>
            <div>
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .wholesale-commercial-guidance {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__inner {
    width: min(100% - 4rem, 136rem);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 14rem) 0;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 4rem;
    align-items: end;
    margin-bottom: clamp(4rem, 7vw, 8rem);
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(var(--color-foreground), 0.62);
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__heading {
    max-width: 58rem;
    margin: 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 4.2vw, 5.8rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--font-heading-letter-spacing);
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__text {
    max-width: 54rem;
    margin: 0;
    color: rgba(var(--color-foreground), 0.72);
    font-family: var(--font-body-family);
    font-size: 1.7rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 2rem;
    min-height: 20rem;
    padding: 3.2rem 3rem 3.2rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item:nth-child(even) {
    padding-right: 0;
    padding-left: 3rem;
    border-left: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__index {
    color: rgba(var(--color-foreground), 0.46);
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item h3 {
    max-width: 30rem;
    margin: 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: var(--font-heading-weight);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item p {
    max-width: 38rem;
    margin: 1.4rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .wholesale-commercial-guidance__header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-commercial-guidance__inner {
      width: min(100% - 3.2rem, 60rem);
      padding: 6rem 0;
    }

    #shopify-section-{{ section.id }} .wholesale-commercial-guidance__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item,
    #shopify-section-{{ section.id }} .wholesale-commercial-guidance__item:nth-child(even) {
      min-height: auto;
      padding: 2.6rem 0;
      border-left: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Curadoria e produção AMMIS",
  "tag": "section",
  "class": "wholesale-commercial-guidance-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Identificação",
      "default": "Curadoria comercial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O pedido começa com uma boa leitura"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introdução",
      "default": "O time comercial orienta a construção do pedido a partir do perfil da loja, do comportamento das clientes e das oportunidades da coleção."
    }
  ],
  "blocks": [
    {
      "type": "guidance",
      "name": "Ponto de orientação",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Indicadores e movimentos de mercado"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Uma leitura comercial para apoiar decisões mais seguras na escolha do mix."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curadoria e produção AMMIS",
      "blocks": [
        { "type": "guidance" },
        { "type": "guidance" },
        { "type": "guidance" },
        { "type": "guidance" }
      ]
    }
  ]
}
{% endschema %}
