<section id="evolucao-parceria-ammis" class="wholesale-partnership-paths">
  <div class="wholesale-partnership-paths__inner">
    <header class="wholesale-partnership-paths__header">
      {% if section.settings.eyebrow != blank %}
        <p class="wholesale-partnership-paths__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="wholesale-partnership-paths__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="wholesale-partnership-paths__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </header>

    {% assign opportunity_blocks = section.blocks | where: 'type', 'opportunity' %}
    {% if opportunity_blocks.size > 0 %}
      <div class="wholesale-partnership-paths__opportunities">
        {% for block in opportunity_blocks %}
          <article class="wholesale-partnership-paths__opportunity{% if block.settings.image != blank or block.settings.image_asset != blank %} wholesale-partnership-paths__opportunity--with-image{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 1200', sizes: '(min-width: 750px) 33vw, 100vw', class: 'wholesale-partnership-paths__image', alt: '' }}
            {% elsif block.settings.image_asset != blank %}
              {% assign small_image = block.settings.image_asset | append: '-600.webp' %}
              {% assign large_image = block.settings.image_asset | append: '-1200.webp' %}
              <img class="wholesale-partnership-paths__image" src="{{ large_image | asset_url }}" srcset="{{ small_image | asset_url }} 600w, {{ large_image | asset_url }} 1200w" sizes="(min-width: 750px) 33vw, 100vw" width="1200" height="1800" alt="" loading="lazy">
            {% endif %}
            <div class="wholesale-partnership-paths__card-content">
              <span class="wholesale-partnership-paths__index" aria-hidden="true">0{{ forloop.index }}</span>
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              <a class="wholesale-partnership-paths__card-link" href="{{ block.settings.link | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.heading | escape }}">
                <span aria-hidden="true">↗</span>
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}


  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .wholesale-partnership-paths {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__inner {
    width: min(100% - 4rem, 136rem);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 14rem) 0;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__header {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 4rem;
    align-items: end;
    margin-bottom: clamp(4rem, 7vw, 8rem);
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(var(--color-foreground), 0.62);
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__heading {
    max-width: 58rem;
    margin: 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 4.2vw, 5.8rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--font-heading-letter-spacing);
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__text {
    max-width: 54rem;
    margin: 0;
    color: rgba(var(--color-foreground), 0.72);
    font-family: var(--font-body-family);
    font-size: 1.7rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunities {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(var(--color-foreground), 0.16);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity {
    min-height: 24rem;
    padding: 3rem 2.4rem 3rem 0;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity + .wholesale-partnership-paths__opportunity {
    padding-left: 2.4rem;
    border-left: 1px solid rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__index {
    display: block;
    margin-bottom: 3.2rem;
    color: rgba(var(--color-foreground), 0.46);
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity h3 {
    margin: 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: var(--font-heading-weight);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity p {
    margin: 1.4rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 5rem;
    margin-top: clamp(6rem, 9vw, 11rem);
    padding-top: 3.5rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.2);
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-intro h3 {
    max-width: 46rem;
    margin: 1.4rem 0 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 3.2vw, 4rem);
    font-weight: var(--font-heading-weight);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-intro > p:last-child {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 4rem;
    align-content: start;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-option {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-mark {
    color: rgba(var(--color-foreground), 0.48);
    font-size: 1.7rem;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-option h4 {
    margin: 0;
    color: rgb(var(--color-foreground-title));
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: var(--font-heading-weight);
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-option p {
    margin: 0.9rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.55;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__header,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__order {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity:nth-child(3) {
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity:nth-child(n + 3) {
      border-top: 1px solid rgba(var(--color-foreground), 0.16);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__inner {
      width: min(100% - 3.2rem, 60rem);
      padding: 6rem 0;
    }

    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunities,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__order-options {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity + .wholesale-partnership-paths__opportunity,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity:nth-child(n + 3) {
      min-height: auto;
      padding: 2.6rem 0;
      border-top: 0;
      border-left: 0;
    }
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunities {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
    border: 0;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity {
    position: relative;
    display: flex;
    align-items: end;
    min-height: 44rem;
    padding: 3.2rem 2.4rem;
    overflow: hidden;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity + .wholesale-partnership-paths__opportunity {
    padding: 3.2rem 2.4rem;
    border: 0;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity--with-image {
    background: #171717;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity--with-image::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 10%, rgba(0, 0, 0, 0.84) 100%);
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity--with-image h3,
  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity--with-image p,
  #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity--with-image .wholesale-partnership-paths__index {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__card-link {
    position: absolute;
    inset: 0;
    padding: 2rem;
    color: #fff;
    text-decoration: none;
    text-align: right;
    font-size: 2.4rem;
  }

  #shopify-section-{{ section.id }} .wholesale-partnership-paths__card-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity:has(a):hover .wholesale-partnership-paths__image {
      transform: scale(1.035);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunities {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity + .wholesale-partnership-paths__opportunity,
    #shopify-section-{{ section.id }} .wholesale-partnership-paths__opportunity:nth-child(n + 3) {
      min-height: 42rem;
      padding: 3.2rem 2.4rem;
      border: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Evolução da parceria",
  "tag": "section",
  "class": "wholesale-partnership-paths-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Identificação",
      "default": "Possibilidades de evolução"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma parceria que pode crescer com a sua loja"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introdução",
      "default": "Conforme a estratégia e o potencial comercial, novas possibilidades podem ser construídas ao longo da relação."
    }
  ],
  "blocks": [
    {
      "type": "opportunity",
      "name": "Possibilidade de evolução",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Exclusividade"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Possibilidade de exclusividade de praça e/ou produto, conforme estratégia e potencial comercial."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem de fundo"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Arquivo de imagem do tema"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do card"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evolução da parceria",
      "blocks": [
        {
          "type": "opportunity"
        },
        {
          "type": "opportunity"
        },
        {
          "type": "opportunity"
        }
      ]
    }
  ]
}
{% endschema %}
