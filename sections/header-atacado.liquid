{% comment %} ==========================================
           BUSCA B2B INTEGRADA NA LINHA (ÍCONE + OVERLAY)
           ========================================== {% endcomment %}
        
        <style>
          /* Estilo do Ícone Injetado */
          .b2b-header-search-icon {
            background: none; border: none; padding: 0; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: rgba(var(--color-foreground), 1); width: 4.4rem; height: 4.4rem;
          }
          
          /* Estilo do Overlay de Busca Corrigido */
          #b2b-search-overlay {
            display: none; 
            position: absolute; /* Fica preso aos limites do cabeçalho */
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; /* Herda a altura exata do cabeçalho */
            min-height: 70px;
            background-color: rgb(var(--color-background)); /* Fundo sólido garantido */
            z-index: 99999; /* Sobrepõe a logo e ícones */
            align-items: center; 
            justify-content: center;
            padding: 0 4rem;
          }
          .b2b-search-inner { 
            max-width: 800px; 
            width: 100%; 
            display: flex; 
            gap: 1.5rem; 
            align-items: center; 
          }
          .b2b-search-inner input {
            flex-grow: 1; 
            border: none; 
            font-size: 1.8rem; 
            background: transparent; 
            outline: none; 
            padding: 1.5rem 0; 
            color: rgba(var(--color-foreground), 1);
          }
          .b2b-search-inner input::placeholder {
            color: rgba(var(--color-foreground), 0.5);
          }
        </style>

        <div id="b2b-search-overlay">
          <div class="b2b-search-inner">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <form id="b2b-ajax-search-form" style="flex-grow:1; margin:0; display:flex;">
              <input type="text" id="b2b-search-input" placeholder="O que você procura no atacado?" autocomplete="off">
            </form>
            <button type="button" onclick="document.getElementById('b2b-search-overlay').style.display='none'" style="background:none; border:none; cursor:pointer; font-size:2.5rem;">&times;</button>
          </div>
        </div>

<script>
 document.addEventListener('DOMContentLoaded', function() {
  // 1. INJEÇÃO DO ÍCONE DE BUSCA
  const iconsContainer = document.querySelector('.header__icons');
  if (iconsContainer && !document.querySelector('.b2b-header-search-icon')) {
    const searchBtn = document.createElement('button');
    searchBtn.className = 'b2b-header-search-icon';
    searchBtn.setAttribute('type', 'button');
    searchBtn.innerHTML = `
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>`;
    
    searchBtn.onclick = function() {
      const overlay = document.getElementById('b2b-search-overlay');
      if (overlay) {
        overlay.style.display = 'flex';
        document.getElementById('b2b-search-input').focus();
      }
    };
    iconsContainer.prepend(searchBtn);
  }

  // 2. LÓGICA DE BUSCA AJAX (USA O TEMPLATE ALTERNATIVO)
  const searchForm = document.getElementById('b2b-ajax-search-form');
  if (searchForm) {
    searchForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const query = document.getElementById('b2b-search-input').value.trim();
      const grid = document.querySelector('.b2b-grid');
      const overlay = document.getElementById('b2b-search-overlay');

      if (!query || !grid) return;

      overlay.style.display = 'none';
      grid.style.opacity = '0.5';
      grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 5rem; font-size: 1.6rem;">Buscando produtos...</p>';

      fetch(`/search?q=${encodeURIComponent(query + ' AND tag:atacado')}&type=product&view=b2b-ajax`)
        .then(response => response.text())
        .then(html => {
          grid.style.opacity = '1';
          grid.innerHTML = html;
        })
        .catch(error => {
          grid.style.opacity = '1';
          grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 5rem; font-size: 1.6rem;">Erro ao carregar resultados.</p>';
        });
    });
  }

  // 3. INTERCEPTOR DE CARRINHO (ATUALIZAÇÃO EM TEMPO REAL)
  document.addEventListener('submit', function(e) {
    const form = e.target.closest('.b2b-add-form');
    if (!form) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const submitButton = form.querySelector('button[type="submit"]');
    const formData = new FormData(form);

    // Solicita as seções para atualizar o ícone e o drawer automaticamente
    formData.append('sections', 'cart-drawer,cart-icon-bubble');
    formData.append('sections_url', window.location.pathname);

    if (submitButton) {
      submitButton.disabled = true;
      if (submitButton.querySelector('span')) submitButton.querySelector('span').textContent = 'Adicionando...';
    }

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      body: formData,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.json())
    .then(data => {
      // Verifica se a Shopify retornou erro real (ex: falta de estoque)
      if (data.status && data.status !== 200) {
        throw new Error(data.description || data.message || 'Erro ao adicionar');
      }

      // 1. Atualiza a bolinha de quantidade no ícone do carrinho
      const cartIconBubble = document.getElementById('cart-icon-bubble');
      if (cartIconBubble && data.sections && data.sections['cart-icon-bubble']) {
        cartIconBubble.innerHTML = data.sections['cart-icon-bubble'];
      }

      // 2. Atualiza o conteúdo do Drawer e abre a interface
      const cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) {
        // Tenta usar o método nativo do Dawn para renderizar
        if (typeof cartDrawer.renderContents === 'function') {
          cartDrawer.renderContents(data);
        } else {
          // Fallback manual de injeção de HTML caso o método acima falhe
          const html = new DOMParser().parseFromString(data.sections['cart-drawer'], 'text/html');
          const newContent = html.querySelector('#CartDrawer');
          const currentContent = document.querySelector('#CartDrawer');
          if (newContent && currentContent) currentContent.innerHTML = newContent.innerHTML;
          
          cartDrawer.classList.remove('is-empty');
          if (typeof cartDrawer.open === 'function') cartDrawer.open();
        }
      } else {
        // Se não houver drawer, vai para a página do carrinho
        window.location.href = window.Shopify.routes.root + 'cart';
      }
    })
    .catch(error => {
      console.error('Erro B2B Cart:', error);
      alert('Aviso: ' + error.message);
    })
    .finally(() => {
      if (submitButton) {
        submitButton.disabled = false;
        if (submitButton.querySelector('span')) submitButton.querySelector('span').textContent = 'Adicionar';
      }
    });
  }, true);
});
</script>
