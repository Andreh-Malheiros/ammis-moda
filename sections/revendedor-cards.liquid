{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- style -%}
    {% render 'section-margin' %}
  {%- endstyle -%}

  <section class="revendedor-cards color-{{ section.settings.color_scheme }} background" aria-labelledby="RevendedorCards-{{ section.id }}">
    <div class="container">
      <div class="revendedor-section-heading revendedor-section-heading--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="revendedor-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="RevendedorCards-{{ section.id }}" class="title--section title--section-m-none {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="revendedor-section-heading__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="revendedor-card-grid revendedor-card-grid--{{ section.settings.columns_desktop }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' and block.settings.show_item -%}
            <article class="revendedor-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="revendedor-card__media">
                  {{
                    block.settings.image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 533, 720',
                      sizes: '(min-width: 990px) 25vw, 100vw',
                      class: 'revendedor-card__image',
                      alt: block.settings.image_alt
                  }}
                </div>
              {%- elsif block.settings.icon_text != blank -%}
                <span class="revendedor-card__icon" aria-hidden="true">{{ block.settings.icon_text | escape }}</span>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="revendedor-card__heading h3">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="revendedor-card__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Revendedor - beneficios",
  "tag": "section",
  "class": "revendedor-cards-section spaced-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "default": true,
      "label": "Exibir secao"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretitulo"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Por que levar a AMMIS para a sua loja?",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Colunas no desktop"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "limit": 12,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_item",
          "default": true,
          "label": "Exibir item"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icone textual opcional"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem opcional"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texto alternativo"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Titulo do beneficio",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Descreva o beneficio de forma objetiva.</p>",
          "label": "t:sections.all.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Revendedor - beneficios"
    }
  ]
}
{% endschema %}
