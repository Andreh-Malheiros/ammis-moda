{{ 'section-configurable-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'configurable-product-initial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign configurator_enabled = product.metafields.custom.configurator_enabled.value
  assign configurable_dialog_id = 'ConfigurableProductDialog-' | append: section.id
  assign configurable_data_id = 'ConfigurableProductData-' | append: section.id
  assign configurable_base_name = product.metafields.custom.configurator_base_name.value
  assign ssr_groups = product.metafields.custom.configurator_groups.value
  assign ssr_size_name = ''
  for product_option in product.options
    assign product_option_handle = product_option | handleize
    if product_option_handle == 'tamanho' or product_option_handle == 'size'
      assign ssr_size_name = product_option | strip
    endif
  endfor
  assign ssr_size_values = ''
  for product_option_with_values in product.options_with_values
    assign ssr_option_handle = product_option_with_values.name | handleize
    if ssr_option_handle == 'tamanho' or ssr_option_handle == 'size'
      assign ssr_size_values = product_option_with_values.values
    endif
  endfor
  assign ssr_featured = nil
  if configurator_enabled == true and section.settings.show_featured_group
    for ssr_group in ssr_groups
      if ssr_featured == nil
        for ssr_option in ssr_group.options.value
          assign ssr_addition = ssr_option.price_addition.value | times: 100 | round
          if ssr_addition > 0
            assign ssr_featured = ssr_group
            break
          endif
        endfor
      endif
    endfor
  endif
  assign configurable_form_id = 'ConfigurableProductForm-' | append: section.id
  assign product_image = product.featured_media.preview_image
  assign eyebrow_text = section.settings.eyebrow | default: 'products.product.configurator.eyebrow' | t
  assign heading_text = section.settings.heading | default: 'products.product.configurable_pdp.title' | t
  assign start_label_text = section.settings.start_label | default: 'products.product.configurator.open' | t
-%}

<section
  id="ConfigurableProduct-{{ section.id }}"
  class="configurable-product color-{{ section.settings.color_scheme }} background{% if section.settings.enable_animations %} configurable-product--motion{% endif %}"
  style="--configurable-media-width: {{ section.settings.media_width }}%; --configurable-panel-radius: {{ section.settings.panel_radius }}px;"
  data-configurable-pdp
  data-animations="{{ section.settings.enable_animations }}"
  data-show-featured-group="{{ section.settings.show_featured_group }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-base-name="{{ configurable_base_name | escape }}"
  data-configurator-enabled="{% if configurator_enabled == true %}true{% else %}false{% endif %}"
  data-label-starting-price="{{ 'products.product.configurable_pdp.from_price' | t | escape }}"
  data-label-no-addition="{{ 'products.product.configurable_pdp.no_addition' | t | escape }}"
  data-label-step="{{ 'products.product.configurator.step' | t: current: '__CURRENT__', total: '__TOTAL__' | escape }}"
  data-label-choose="{{ 'products.product.configurator.choose' | t: group: '__GROUP__' | escape }}"
  data-label-required="{{ 'products.product.configurator.required' | t | escape }}"
  data-label-required-error="{{ 'products.product.configurator.required_error' | t: group: '__GROUP__' | escape }}"
  data-label-select-option="{{ 'products.product.configurator.select_option' | t | escape }}"
  data-label-not-selected="{{ 'products.product.configurator.not_selected' | t | escape }}"
  data-label-base-price="{{ 'products.product.configurator.base_price' | t | escape }}"
  data-label-customizations="{{ 'products.product.configurator.customizations' | t | escape }}"
  data-label-estimated-total="{{ 'products.product.configurator.estimated_total' | t | escape }}"
  data-label-display-only="{{ 'products.product.configurator.display_only' | t | escape }}"
  data-label-back="{{ 'products.product.configurator.back' | t | escape }}"
  data-label-continue="{{ 'products.product.configurator.continue' | t | escape }}"
  data-label-review="{{ 'products.product.configurator.review' | t | escape }}"
  data-label-review-title="{{ 'products.product.configurator.review_title' | t | escape }}"
  data-label-review-intro="{{ 'products.product.configurator.review_intro' | t | escape }}"
  data-label-review-button="{{ 'products.product.configurator.review_button' | t | escape }}"
  data-label-add-to-cart="{{ 'products.product.configurator.add_to_cart' | t | escape }}"
  data-label-price-strategy-pending="{{ 'products.product.configurator.price_strategy_pending' | t | escape }}"
  data-label-edit="{{ 'products.product.configurator.edit' | t | escape }}"
  data-label-edit-group="{{ 'products.product.configurator.edit_group' | t: group: '__GROUP__' | escape }}"
  data-label-cart-error="{{ 'products.product.configurator.add_to_cart_error' | t | escape }}"
  data-label-unavailable="{{ 'products.product.configurator.unavailable' | t | escape }}"
  data-label-error="{{ 'products.product.configurable_pdp.unavailable' | t | escape }}"
  data-label-no-image="{{ 'products.product.configurable_pdp.no_image' | t | escape }}"
  data-label-zoom="{{ 'products.product.configurator.zoom' | t | escape }}"
  data-label-close="{{ 'products.product.configurator.close' | t | escape }}"
  data-label-clear="{{ 'products.product.configurator.clear' | t | escape }}"
  data-label-optional="{{ 'products.product.configurator.optional' | t | escape }}"
  data-label-almost-there="{{ 'products.product.configurator.almost_there' | t | escape }}"
  data-label-size-chart="{{ 'products.product.configurator.size_chart' | t | escape }}"
  data-label-option-count-one="{{ 'products.product.configurable_pdp.step_option_count' | t: count: 1 | replace: '1', '__COUNT__' | escape }}"
  data-label-option-count-other="{{ 'products.product.configurable_pdp.step_option_count' | t: count: 2 | replace: '2', '__COUNT__' | escape }}"
  data-label-size-range="{{ 'products.product.configurable_pdp.step_size_range' | t: first: '__FIRST__', last: '__LAST__' | escape }}"
  data-label-chosen="{{ 'products.product.configurator.chosen' | t | escape }}"
  data-label-select-card="{{ 'products.product.configurator.select_card' | t | escape }}"
>
  <script
    type="application/json"
    id="{{ configurable_data_id }}"
    data-configurable-payload
  >{% render 'configurable-product-data', product: product %}</script>

  <script type="application/json" data-configurable-messages>
    [
      {%- for block in section.blocks -%}
        {%- if block.type == 'step_message' -%}
          {"groupCode": {{ block.settings.group_code | json }}, "kind": {{ block.settings.kind | json }}, "text": {{ block.settings.text | json }}}{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  {%- assign size_chart_page = section.settings.size_chart_page -%}
  {%- if size_chart_page != blank and size_chart_page.content != blank -%}
    <div hidden data-configurable-size-chart>{{ size_chart_page.content }}</div>
  {%- endif -%}

  {%- assign product_description_text = product.description | strip_html | strip -%}
  {%- if product_description_text != blank -%}
    <div hidden data-configurable-product-description>{{ product.description }}</div>
  {%- endif -%}

  <div class="configurable-product__layout page-width">
    <div class="configurable-product__media">
      <figure class="configurable-product__figure" data-configurable-visual>
        {% if product_image != blank %}
          {%- capture main_image_html -%}
            {{
              product_image
              | image_url: width: 1200
              | image_tag:
                class: 'configurable-product__image',
                widths: '600, 900, 1200',
                sizes: '(min-width: 990px) 40vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: product_image.alt | default: product.title
            }}
          {%- endcapture -%}
          <button type="button" class="configurable-product__image-button" data-configurable-zoom-image-trigger aria-haspopup="dialog" aria-label="{{ 'products.product.configurator.zoom' | t | escape }}">
            {{ main_image_html | replace: '<img ', '<img data-configurable-main-image ' }}
          </button>
        {% else %}
          <div class="configurable-product__image-fallback" data-configurable-image-fallback role="img" aria-label="{{ 'products.product.configurable_pdp.no_image' | t | escape }}">
            {{ 'products.product.configurable_pdp.no_image' | t }}
          </div>
        {% endif %}
      </figure>
      <button type="button" class="configurable-product__zoom-trigger" data-configurable-zoom-open{% if product_image == blank %} hidden{% endif %}>
        {{ 'products.product.configurator.zoom' | t }}
      </button>
    </div>

    <div class="configurable-product__content">
      <header class="configurable-product__header">
        {%- if eyebrow_text != blank -%}
          <p class="configurable-product__eyebrow">{{ eyebrow_text | escape }}</p>
        {%- endif -%}
        <h1 class="configurable-product__heading h1">{{ heading_text | escape }}</h1>
        <div class="configurable-product__header-row">
          <div class="configurable-product__intro">
            <p class="configurable-product__product-name" data-configurable-product-title>{{ product.title | escape }}</p>
            {%- if section.settings.intro != blank -%}
              <div class="configurable-product__intro-text rte">{{ section.settings.intro | newline_to_br }}</div>
            {%- endif -%}
          </div>
          <div class="configurable-product__price" aria-live="polite">
            <span class="configurable-product__price-label">{{ 'products.product.configurable_pdp.from_price' | t }}</span>
            <strong class="configurable-product__price-value" data-configurable-starting-price>—</strong>
          </div>
        </div>
      </header>

      <div class="configurable-product__panel">
        <section class="configurable-product__summary" aria-labelledby="ConfigurableProductSummary-{{ section.id }}" data-configurable-summary-section{% if ssr_featured == nil %} hidden{% endif %}>
          <h2 id="ConfigurableProductSummary-{{ section.id }}" class="visually-hidden">
            {{ 'products.product.configurable_pdp.possible_additions' | t }}
          </h2>
          <div data-configurable-summary>
            {%- if ssr_featured != nil -%}
              {%- assign ssr_featured_title = ssr_featured.title.value | default: ssr_featured.code.value | default: ssr_featured.system.handle -%}
              <div class="configurable-product__featured-head">
                <h3 class="configurable-product__addition-title">{{ ssr_featured_title | strip | escape }}</h3>
              </div>
              <ul class="configurable-product__featured-list">
                {%- for ssr_option in ssr_featured.options.value -%}
                  {%- assign ssr_addition = ssr_option.price_addition.value | times: 100 | round -%}
                  {%- assign ssr_option_image = ssr_option.image.value -%}
                  <li class="configurable-product__featured-option">
                    {%- if ssr_option_image != blank -%}
                      <img class="configurable-product__featured-thumb" src="{{ ssr_option_image | image_url: width: 800 }}" srcset="{{ ssr_option_image | image_url: width: 320 }} 320w, {{ ssr_option_image | image_url: width: 480 }} 480w, {{ ssr_option_image | image_url: width: 800 }} 800w" sizes="(min-width: 750px) 25vw, 50vw" width="{{ ssr_option_image.width }}" height="{{ ssr_option_image.height }}" alt="" loading="lazy">
                    {%- elsif ssr_option.color.value != blank -%}
                      <span class="configurable-product__featured-thumb configurable-product__swatch" style="--configurable-swatch-color: {{ ssr_option.color.value | escape }}" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="configurable-product__featured-copy">
                      <span class="configurable-product__featured-name">{{ ssr_option.name.value | escape }}</span>
                      {%- liquid
                        if ssr_option.available.value == false
                          assign ssr_unavailable_label = 'products.product.configurator.unavailable' | t
                          assign ssr_addition_label = 'products.product.configurable_pdp.no_addition' | t | append: ' — ' | append: ssr_unavailable_label
                        elsif ssr_addition > 0
                          assign ssr_money = ssr_addition | money
                          assign ssr_addition_label = ssr_money | replace: ' ', '&nbsp;' | prepend: '+'
                        else
                          assign ssr_addition_label = 'products.product.configurable_pdp.no_addition' | t
                        endif
                      -%}
                      <span class="configurable-product__featured-addition">{{ ssr_addition_label }}</span>
                    </span>
                  </li>
                {%- endfor -%}
              </ul>
              <p class="configurable-product__display-note configurable-product__featured-note">{{ 'products.product.configurator.display_only' | t }}</p>
            {%- endif -%}
          </div>
        </section>

        <section class="configurable-product__steps" aria-labelledby="ConfigurableProductSteps-{{ section.id }}">
          <h2 id="ConfigurableProductSteps-{{ section.id }}" class="visually-hidden">
            {{ 'products.product.configurable_pdp.steps' | t }}
          </h2>
          <ol class="configurable-product__step-list" data-configurable-overview-steps>
            {%- assign ssr_step_index = 0 -%}
            {%- if configurator_enabled == true -%}
              {%- for ssr_group in ssr_groups -%}
                {%- if ssr_group.options.value != blank -%}
                  {%- assign ssr_step_index = ssr_step_index | plus: 1 -%}
                  {%- assign ssr_group_code = ssr_group.code.value | default: ssr_group.system.handle | strip | downcase -%}
                  {%- assign ssr_summary = 'products.product.configurable_pdp.step_option_count' | t: count: ssr_group.options.value.size -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'step_message' and block.settings.kind == 'resumo' and block.settings.text != blank -%}
                      {%- assign ssr_block_code = block.settings.group_code | strip | downcase -%}
                      {%- if ssr_block_code == ssr_group_code -%}{%- assign ssr_summary = block.settings.text | strip -%}{%- break -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <li class="configurable-product__step-item"><span class="configurable-product__step-number">{{ ssr_step_index }}</span><span class="configurable-product__step-title">{{ ssr_group.title.value | default: ssr_group.code.value | default: ssr_group.system.handle | strip | escape }}</span><span class="configurable-product__step-summary">{{ ssr_summary | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
              {%- if ssr_size_name != blank and ssr_step_index > 0 -%}
                {%- assign ssr_step_index = ssr_step_index | plus: 1 -%}
                {%- assign ssr_size_code = ssr_size_name | strip | downcase -%}
                {%- assign ssr_size_summary = '' -%}
                {%- if ssr_size_values.size == 1 -%}
                  {%- assign ssr_size_summary = ssr_size_values.first -%}
                {%- elsif ssr_size_values.size > 1 -%}
                  {%- assign ssr_size_summary = 'products.product.configurable_pdp.step_size_range' | t: first: ssr_size_values.first, last: ssr_size_values.last -%}
                {%- endif -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'step_message' and block.settings.kind == 'resumo' and block.settings.text != blank -%}
                    {%- assign ssr_block_code = block.settings.group_code | strip | downcase -%}
                    {%- if ssr_block_code == ssr_size_code -%}{%- assign ssr_size_summary = block.settings.text | strip -%}{%- break -%}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                <li class="configurable-product__step-item"><span class="configurable-product__step-number">{{ ssr_step_index }}</span><span class="configurable-product__step-title">{{ ssr_size_name | escape }}</span>{% if ssr_size_summary != blank %}<span class="configurable-product__step-summary">{{ ssr_size_summary | escape }}</span>{% endif %}</li>
              {%- endif -%}
            {%- endif -%}
          </ol>
        </section>

        {%- assign details_description = product.description | strip_html | strip -%}
        {%- assign has_details = false -%}
        {%- if section.settings.show_description and details_description != blank -%}{%- assign has_details = true -%}{%- endif -%}
        {%- if size_chart_page != blank and size_chart_page.content != blank -%}{%- assign has_details = true -%}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' and block.settings.content != blank -%}{%- assign has_details = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_details -%}
          <div class="configurable-product__details" data-configurable-details>
            {%- if section.settings.show_description and details_description != blank -%}
              <details class="configurable-product__detail">
                <summary class="configurable-product__detail-summary">{{ 'products.product.configurable_pdp.details_description' | t }}</summary>
                <div class="configurable-product__detail-body rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'detail' and block.settings.content != blank -%}
                <details class="configurable-product__detail" {{ block.shopify_attributes }}>
                  <summary class="configurable-product__detail-summary">{{ block.settings.title | default: '—' | escape }}</summary>
                  <div class="configurable-product__detail-body rte">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
            {%- if size_chart_page != blank and size_chart_page.content != blank -%}
              <details class="configurable-product__detail">
                <summary class="configurable-product__detail-summary">{{ 'products.product.configurator.size_chart' | t }}</summary>
                <div class="configurable-product__detail-body rte">{{ size_chart_page.content }}</div>
              </details>
            {%- endif -%}
          </div>
        {%- endif -%}

        <button
          type="button"
          class="button button--primary configurable-product__start"
          data-configurable-start
          disabled
          aria-disabled="true"
          aria-haspopup="dialog"
          aria-controls="{{ configurable_dialog_id }}"
        >
          <span>{{ start_label_text | escape }}</span>
          <svg class="configurable-product__start-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </button>
        <p class="configurable-product__status" data-configurable-status role="status" aria-live="polite" hidden></p>
      </div>
    </div>
  </div>

  <dialog
    id="{{ configurable_dialog_id }}"
    class="configurable-product__dialog"
    data-configurable-dialog
    aria-labelledby="ConfigurableProductDialogTitle-{{ section.id }}"
  >
    <div class="configurable-product__dialog-surface">
      <header class="configurable-product__dialog-header">
        <div class="configurable-product__dialog-heading">
          <p class="configurable-product__progress-label" data-configurable-progress-label></p>
          <h2 id="ConfigurableProductDialogTitle-{{ section.id }}" class="configurable-product__dialog-title" data-configurable-dialog-title tabindex="-1">
            {{ 'products.product.configurator.review_title' | t }}
          </h2>
        </div>
        <ol class="configurable-product__step-list configurable-product__dialog-trail" data-configurable-dialog-steps></ol>
        <button type="button" class="configurable-product__dialog-close" data-configurable-close aria-label="{{ 'products.product.configurator.close' | t | escape }}">
          <span class="configurable-product__dialog-close-text">{{ 'products.product.configurable_pdp.close' | t }}</span>
          <span aria-hidden="true">&times;</span>
        </button>
        <div class="configurable-product__progress" data-configurable-progress role="progressbar" aria-label="{{ 'products.product.configurator.progress' | t | escape }}" aria-valuemin="1" aria-valuemax="1" aria-valuenow="1">
          <span class="configurable-product__progress-track"><span data-configurable-progress-bar></span></span>
        </div>
      </header>
      <p class="configurable-product__live visually-hidden" data-configurable-live aria-live="polite"></p>

      <div class="configurable-product__dialog-body">
        <div class="configurable-product__dialog-media">
          <figure class="configurable-product__dialog-figure" data-configurable-dialog-visual>
            <button type="button" class="configurable-product__image-button" data-configurable-zoom-image-trigger data-configurable-dialog-image-host aria-label="{{ 'products.product.configurator.zoom' | t | escape }}" hidden></button>
            <p class="configurable-product__display-note" data-configurable-dialog-image-fallback hidden>{{ 'products.product.configurable_pdp.no_image' | t }}</p>
          </figure>
          <div class="configurable-product__dialog-media-meta">
            <p class="configurable-product__combination-name" data-configurable-combination-name></p>
            <button type="button" class="configurable-product__dialog-zoom" data-configurable-zoom-open data-configurable-dialog-zoom hidden>
              {{ 'products.product.configurator.zoom_photo' | t }}
            </button>
          </div>
        </div>

        <div class="configurable-product__dialog-panel">
          <div class="configurable-product__dialog-panel-inner">
            <span class="configurable-product__panel-handle" aria-hidden="true"></span>
            <div class="configurable-product__dialog-panel-content" data-configurable-dialog-body>
              <div data-configurable-step-content></div>
              <div data-configurable-review hidden></div>

            </div>
            <footer class="configurable-product__dialog-footer">
              <button type="button" class="button button--secondary configurable-product__back" data-configurable-back hidden>
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12H4M10 6l-6 6 6 6"/></svg>
                <span class="configurable-product__back-text">{{ 'products.product.configurator.back' | t }}</span>
              </button>
              <button type="button" class="button button--primary configurable-product__next" data-configurable-next>
                {{ 'products.product.configurator.continue' | t }}
              </button>
              <product-form
            class="product-form configurable-product__product-form"
            data-configurable-product-form
            data-hide-errors="false"
            hidden
          >
            {% form 'product', product, id: configurable_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
              <div class="product-form__error-message-wrapper" role="alert" hidden data-configurable-form-error>
                <span class="product-form__error-message" data-configurable-form-error-message></span>
              </div>
              <input type="hidden" name="id" value="" data-configurable-variant-id>
              <input type="hidden" name="quantity" value="1" data-configurable-quantity>
              <div data-configurable-properties></div>
              <button type="submit" name="add" class="button button--primary configurable-product__submit" aria-disabled="true" disabled data-configurable-submit>
                <span>{{ 'products.product.configurator.add_to_cart' | t }}</span>
                <span class="loading-overlay__spinner hidden" aria-hidden="true" data-configurable-spinner></span>
              </button>
            {% endform %}
            <p class="configurable-product__price-gate configurable-product__display-note" data-configurable-price-gate hidden role="status" aria-live="polite">
              {{ 'products.product.configurator.price_strategy_pending' | t }}
            </p>
          </product-form>
            </footer>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <dialog class="configurable-product__zoom" data-configurable-zoom aria-labelledby="ConfigurableProductZoomTitle-{{ section.id }}">
    <div class="configurable-product__zoom-surface">
      <h3 id="ConfigurableProductZoomTitle-{{ section.id }}" class="visually-hidden">{{ 'products.product.configurator.zoom' | t }}</h3>
      <button type="button" class="configurable-product__dialog-close" data-configurable-zoom-close aria-label="{{ 'products.product.configurator.close' | t | escape }}"><span aria-hidden="true">&times;</span></button>
      {% if product_image != blank %}
        {%- capture zoom_image_html -%}
          {{ product_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: product_image.alt | default: product.title }}
        {%- endcapture -%}
        {{ zoom_image_html | replace: '<img ', '<img data-configurable-zoom-image ' }}
      {% endif %}
    </div>
  </dialog>

</section>

{% schema %}
{
  "name": "Configurable PDP",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
