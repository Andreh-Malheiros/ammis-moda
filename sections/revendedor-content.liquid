{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- liquid
    assign media_count = 0
    assign visible_feature_count = 0

    if section.settings.show_media
      if section.settings.image != blank
        assign media_count = media_count | plus: 1
      endif

      for block in section.blocks
        if block.type == 'image' and block.settings.image != blank
          assign media_count = media_count | plus: 1
        endif
      endfor
    endif

    for block in section.blocks
      if block.type == 'feature' and block.settings.show_item and block.settings.text != blank
        assign visible_feature_count = visible_feature_count | plus: 1
      endif
    endfor

    assign section_layout = section.settings.layout

    if media_count == 0
      assign section_layout = 'text-only'
    endif

    assign show_primary_button = false
    assign show_secondary_button = false

    if section.settings.button_label != blank and section.settings.button_link != blank
      assign show_primary_button = true
    endif

    if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
      assign show_secondary_button = true
    endif
  -%}

  {%- style -%}
    {% render 'section-margin' %}

    #shopify-section-{{ section.id }} {
      --revendedor-background: rgb(var(--color-background));
      --revendedor-foreground: rgb(var(--color-foreground));
      --revendedor-muted: rgba(var(--color-foreground), 0.68);
      --revendedor-muted-light: rgba(var(--color-foreground), 0.48);
      --revendedor-border: rgba(var(--color-foreground), 0.14);
      --revendedor-border-strong: rgba(var(--color-foreground), 0.26);
      --revendedor-surface: rgba(var(--color-foreground), 0.028);
      --revendedor-dark: #171717;
      --revendedor-light: #ffffff;
    }

    /*
      Estrutura principal
    */

    #shopify-section-{{ section.id }} .revendedor-content {
      position: relative;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .revendedor-content__container {
      width: 100%;
      max-width: var(--page-width, 144rem);
      margin: 0 auto;
      padding-right: 5rem;
      padding-left: 5rem;
    }

    #shopify-section-{{ section.id }} .revendedor-content__shell {
      position: relative;
      padding: clamp(6rem, 8vw, 11rem) 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__grid {
      display: grid;
      grid-template-columns: minmax(34rem, 0.9fr) minmax(0, 1.12fr);
      gap: clamp(5rem, 7vw, 10rem);
      align-items: center;
      min-width: 0;
    }

    /*
      Ordem das colunas
    */

    #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__media-column {
      grid-column: 1;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__copy {
      grid-column: 2;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-column {
      grid-column: 2;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__copy {
      grid-column: 1;
      grid-row: 1;
    }

    #shopify-section-{{ section.id }} .revendedor-content--text-only .revendedor-content__grid {
      display: block;
    }

    #shopify-section-{{ section.id }} .revendedor-content--text-only .revendedor-content__copy {
      max-width: 92rem;
      margin: 0 auto;
    }

    /*
      Coluna de imagem
    */

    #shopify-section-{{ section.id }} .revendedor-content__media-column {
      position: relative;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-frame {
      position: relative;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-frame::before {
      content: '';
      position: absolute;
      top: 2.4rem;
      right: -2.4rem;
      bottom: -2.4rem;
      left: 2.4rem;
      z-index: 0;
      border: 1px solid var(--revendedor-border);
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-frame::before {
      right: 2.4rem;
      left: -2.4rem;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-grid {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 1.2rem;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'] {
      grid-template-columns: minmax(0, 1.5fr) minmax(11rem, 0.5fr);
      grid-template-rows: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'],
    #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] {
      grid-template-columns: minmax(0, 1.5fr) minmax(11rem, 0.5fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure {
      position: relative;
      min-width: 0;
      min-height: 0;
      margin: 0;
      overflow: hidden;
      background: var(--revendedor-surface);
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure:first-child {
      grid-row: 1 / -1;
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      border: 1px solid rgba(255, 255, 255, 0.08);
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure--portrait {
      aspect-ratio: 4 / 5;
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure--landscape {
      aspect-ratio: 4 / 3;
    }

    #shopify-section-{{ section.id }} .revendedor-content__figure--square {
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure {
      aspect-ratio: 4 / 5.15;
      min-height: 58rem;
    }

    #shopify-section-{{ section.id }} .revendedor-content__image {
      display: block;
      width: 100%;
      height: 100%;
      min-height: inherit;
      object-fit: cover;
      object-position: {{ section.settings.image_position }};
      transform: scale(1.015);
      transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-frame:hover .revendedor-content__image {
      transform: scale(1.045);
    }

    /*
      Selo editorial
    */

    #shopify-section-{{ section.id }} .revendedor-content__media-index {
      position: absolute;
      right: 2rem;
      bottom: 2rem;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.3rem;
      color: var(--revendedor-light);
      background: rgba(17, 17, 17, 0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      font-size: 1rem;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-index::before {
      content: '';
      width: 2rem;
      height: 1px;
      background: currentColor;
      opacity: 0.65;
    }

    /*
      Coluna de conteúdo
    */

    #shopify-section-{{ section.id }} .revendedor-content__copy {
      position: relative;
      min-width: 0;
      padding: clamp(1rem, 2vw, 3rem) 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__copy--center {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .revendedor-content__copy--center > * {
      margin-right: auto;
      margin-left: auto;
    }

    #shopify-section-{{ section.id }} .revendedor-content__eyebrow {
      display: flex;
      align-items: center;
      gap: 1.4rem;
      margin: 0 0 2rem;
      color: var(--revendedor-muted);
      font-size: 1.1rem;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: 0.17em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .revendedor-content__eyebrow::before {
      content: '';
      display: block;
      width: 3.2rem;
      height: 1px;
      background: var(--revendedor-foreground);
      opacity: 0.6;
    }

    #shopify-section-{{ section.id }} .revendedor-content__copy--center .revendedor-content__eyebrow {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .revendedor-content__heading {
      max-width: 66rem;
      margin: 0;
      font-size: clamp(3.8rem, 4.4vw, 7rem);
      font-weight: 400;
      line-height: 0.99;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }

    #shopify-section-{{ section.id }} .revendedor-content__text {
      max-width: 64rem;
      margin-top: 3rem;
      color: var(--revendedor-muted);
      font-size: 1.55rem;
      line-height: 1.72;
    }

    #shopify-section-{{ section.id }} .revendedor-content__text p {
      color: inherit;
    }

    #shopify-section-{{ section.id }} .revendedor-content__text > *:first-child,
    #shopify-section-{{ section.id }} .revendedor-content__note > *:first-child {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .revendedor-content__text > *:last-child,
    #shopify-section-{{ section.id }} .revendedor-content__note > *:last-child {
      margin-bottom: 0;
    }

    /*
      Lista de benefícios
    */

    #shopify-section-{{ section.id }} .revendedor-content__features-wrapper {
      width: 100%;
      max-width: 68rem;
      margin-top: 3.8rem;
      padding-top: 2.8rem;
      border-top: 1px solid var(--revendedor-border);
    }

    #shopify-section-{{ section.id }} .revendedor-content__features-title {
      margin: 0 0 1.8rem;
      color: var(--revendedor-foreground);
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.4;
    }

    #shopify-section-{{ section.id }} .revendedor-content__features {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .revendedor-content__feature {
      position: relative;
      display: grid;
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: 1.8rem;
      align-items: start;
      padding: 1.7rem 0;
      color: var(--revendedor-foreground);
      border-bottom: 1px solid var(--revendedor-border);
      font-size: 1.42rem;
      line-height: 1.58;
    }

    #shopify-section-{{ section.id }} .revendedor-content__feature::after {
      content: '';
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 1px;
      background: var(--revendedor-foreground);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    #shopify-section-{{ section.id }} .revendedor-content__feature:hover::after {
      transform: scaleX(1);
    }

    #shopify-section-{{ section.id }} .revendedor-content__feature-number {
      display: inline-flex;
      align-items: center;
      color: var(--revendedor-muted-light);
      font-size: 1.05rem;
      font-weight: 500;
      line-height: 1.5;
      letter-spacing: 0.12em;
    }

    #shopify-section-{{ section.id }} .revendedor-content__feature-number::after {
      content: '';
      display: block;
      width: 1.4rem;
      height: 1px;
      margin-left: 0.8rem;
      background: currentColor;
    }

    /*
      Nota e botões
    */

    #shopify-section-{{ section.id }} .revendedor-content__footer {
      width: 100%;
      max-width: 68rem;
      margin-top: 3.6rem;
    }

    #shopify-section-{{ section.id }} .revendedor-content__note {
      padding: 2.3rem 2.4rem;
      color: var(--revendedor-muted);
      background: var(--revendedor-surface);
      border-left: 2px solid var(--revendedor-foreground);
      font-size: 1.4rem;
      line-height: 1.65;
    }

    #shopify-section-{{ section.id }} .revendedor-content__note p {
      color: inherit;
    }

    #shopify-section-{{ section.id }} .revendedor-button-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
      width: 100%;
      margin-top: 2.4rem;
    }

    #shopify-section-{{ section.id }} .revendedor-button-group .button {
      min-width: 21rem;
      min-height: 5.4rem;
      padding: 1.5rem 2.8rem;
      justify-content: center;
      border-radius: 0;
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: 0.11em;
      text-align: center;
      text-transform: uppercase;
      transition:
        color 280ms ease,
        background-color 280ms ease,
        border-color 280ms ease,
        transform 280ms ease;
    }

    #shopify-section-{{ section.id }} .revendedor-button-group .button:first-child {
      color: var(--revendedor-light);
      background: var(--revendedor-dark);
      border-color: var(--revendedor-dark);
    }

    #shopify-section-{{ section.id }} .revendedor-button-group .button:first-child:hover {
      color: var(--revendedor-dark);
      background: transparent;
      border-color: var(--revendedor-dark);
      transform: translateY(-0.2rem);
    }

    /*
      Variações existentes
    */

    #shopify-section-{{ section.id }} .revendedor-content--highlight .revendedor-content__copy {
      padding: clamp(3rem, 4vw, 5rem);
      background: var(--revendedor-surface);
      border: 1px solid var(--revendedor-border);
    }

    #shopify-section-{{ section.id }} .revendedor-content--compact .revendedor-content__shell {
      padding-top: clamp(4rem, 5vw, 7rem);
      padding-bottom: clamp(4rem, 5vw, 7rem);
    }

    #shopify-section-{{ section.id }} .revendedor-content--compact .revendedor-content__grid {
      gap: clamp(4rem, 5vw, 7rem);
    }

    #shopify-section-{{ section.id }} .revendedor-content--compact .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure {
      min-height: 50rem;
    }

    #shopify-section-{{ section.id }} .revendedor-content--form .revendedor-content__copy {
      padding: clamp(3rem, 4vw, 5rem);
      border: 1px solid var(--revendedor-border);
    }

    /*
      Animação de entrada
    */

    #shopify-section-{{ section.id }} [data-reveal] {
      opacity: 0;
      transform: translateY(2.4rem);
      transition:
        opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--reveal-delay, 0ms);
    }

    #shopify-section-{{ section.id }} [data-reveal='media'] {
      transform: translateY(0);
      clip-path: inset(0 0 100% 0);
      transition:
        opacity 300ms ease,
        clip-path 1.05s cubic-bezier(0.22, 1, 0.36, 1);
    }

    #shopify-section-{{ section.id }} .is-visible [data-reveal] {
      opacity: 1;
      transform: translateY(0);
    }

    #shopify-section-{{ section.id }} .is-visible [data-reveal='media'] {
      clip-path: inset(0 0 0 0);
    }

    /*
      Desktop intermediário
    */

    @media screen and (max-width: 1199px) {
      #shopify-section-{{ section.id }} .revendedor-content__container {
        padding-right: 3.2rem;
        padding-left: 3.2rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__grid {
        grid-template-columns: minmax(30rem, 0.88fr) minmax(0, 1.12fr);
        gap: 5rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure {
        min-height: 54rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__heading {
        font-size: clamp(3.8rem, 4.6vw, 6rem);
      }
    }

    /*
      Tablet
    */

    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .revendedor-content__container {
        padding-right: 2.4rem;
        padding-left: 2.4rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__shell {
        padding: 6rem 0;
      }

      #shopify-section-{{ section.id }} .revendedor-content__grid,
      #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__grid,
      #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__grid {
        display: flex;
        flex-direction: column;
        gap: 4.6rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__copy,
      #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__copy,
      #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__copy {
        display: contents;
      }

      #shopify-section-{{ section.id }} .revendedor-content__intro {
        order: 1;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-column {
        order: 2;
        width: 100%;
      }

      #shopify-section-{{ section.id }} .revendedor-content__body {
        order: 3;
      }

      #shopify-section-{{ section.id }} .revendedor-content__features-wrapper {
        order: 4;
      }

      #shopify-section-{{ section.id }} .revendedor-content__footer {
        order: 5;
      }

      #shopify-section-{{ section.id }} .revendedor-content__heading {
        max-width: 72rem;
        font-size: clamp(4rem, 7vw, 6rem);
      }

      #shopify-section-{{ section.id }} .revendedor-content__text,
      #shopify-section-{{ section.id }} .revendedor-content__features-wrapper,
      #shopify-section-{{ section.id }} .revendedor-content__footer {
        max-width: 72rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-frame::before {
        top: 1.8rem;
        right: -1.8rem;
        bottom: -1.8rem;
        left: 1.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-frame::before {
        right: 1.8rem;
        left: -1.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure {
        min-height: 0;
        aspect-ratio: 16 / 10;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'],
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'],
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: auto;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'] .revendedor-content__figure:first-child,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'] .revendedor-content__figure:first-child,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] .revendedor-content__figure:first-child {
        grid-column: span 2;
        grid-row: auto;
        aspect-ratio: 16 / 10;
      }
    }

    /*
      Mobile
    */

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .revendedor-content__container {
        padding-right: 1.8rem;
        padding-left: 1.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__shell {
        padding: 4.8rem 0;
      }

      #shopify-section-{{ section.id }} .revendedor-content__grid {
        gap: 3.2rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__eyebrow {
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        letter-spacing: 0.15em;
      }

      #shopify-section-{{ section.id }} .revendedor-content__eyebrow::before {
        width: 2.4rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__heading {
        max-width: 35rem;
        font-size: clamp(3.3rem, 10.2vw, 4.5rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      #shopify-section-{{ section.id }} .revendedor-content__text {
        margin-top: 2.2rem;
        font-size: 1.45rem;
        line-height: 1.68;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-frame::before {
        top: 1.2rem;
        right: -0.8rem;
        bottom: -1.2rem;
        left: 1.2rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-frame::before {
        right: 1.2rem;
        left: -0.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'],
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'],
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] {
        display: block;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid .revendedor-content__figure,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'] .revendedor-content__figure:first-child,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'] .revendedor-content__figure:first-child,
      #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] .revendedor-content__figure:first-child {
        display: block;
        width: 100%;
        min-height: 0;
        aspect-ratio: 4 / 5;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-grid .revendedor-content__figure:not(:first-child) {
        display: none;
      }

      #shopify-section-{{ section.id }} .revendedor-content__image {
        object-position: {{ section.settings.mobile_image_position }};
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-index {
        right: 1.2rem;
        bottom: 1.2rem;
        padding: 0.9rem 1.1rem;
        font-size: 0.9rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__features-wrapper {
        margin-top: 2.8rem;
        padding-top: 2.3rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__features-title {
        margin-bottom: 1.2rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__feature {
        grid-template-columns: 4rem minmax(0, 1fr);
        gap: 1.2rem;
        padding: 1.5rem 0;
        font-size: 1.38rem;
        line-height: 1.58;
      }

      #shopify-section-{{ section.id }} .revendedor-content__feature-number::after {
        width: 1rem;
        margin-left: 0.6rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__footer {
        margin-top: 2.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__note {
        padding: 1.8rem;
        font-size: 1.35rem;
        line-height: 1.62;
      }

      #shopify-section-{{ section.id }} .revendedor-button-group {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 2rem;
      }

      #shopify-section-{{ section.id }} .revendedor-button-group .button {
        width: 100%;
        min-width: 0;
        min-height: 5.5rem;
        padding: 1.5rem 1.8rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content--highlight .revendedor-content__copy,
      #shopify-section-{{ section.id }} .revendedor-content--form .revendedor-content__copy {
        padding: 2.2rem 1.8rem;
      }
    }

    /*
      Mobile pequeno
    */

    @media screen and (max-width: 389px) {
      #shopify-section-{{ section.id }} .revendedor-content__container {
        padding-right: 1.3rem;
        padding-left: 1.3rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__heading {
        font-size: 3.1rem;
      }

      #shopify-section-{{ section.id }} .revendedor-content__feature {
        grid-template-columns: 3.7rem minmax(0, 1fr);
      }
    }

    /*
      Acessibilidade
    */

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} [data-reveal] {
        opacity: 1;
        transform: none;
        clip-path: none;
        transition: none;
      }

      #shopify-section-{{ section.id }} .revendedor-content__image,
      #shopify-section-{{ section.id }} .revendedor-content__feature::after,
      #shopify-section-{{ section.id }} .revendedor-button-group .button {
        transition: none;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-frame:hover .revendedor-content__image,
      #shopify-section-{{ section.id }} .revendedor-button-group .button:hover {
        transform: none;
      }
    }
  {%- endstyle -%}

  <section
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id | handleize }}"
    {% endif %}
    class="
      revendedor-content
      revendedor-content--{{ section_layout }}
      revendedor-content--{{ section.settings.style }}
      color-{{ section.settings.color_scheme }}
      background
    "
    aria-labelledby="RevendedorContent-{{ section.id }}"
    data-revendedor-content
  >
    <div class="revendedor-content__container">
      <div class="revendedor-content__shell">
        <div class="revendedor-content__grid">

          <div class="revendedor-content__copy revendedor-content__copy--{{ section.settings.alignment }}">
            <div
              class="revendedor-content__intro"
              data-reveal
              style="--reveal-delay: 80ms;"
            >
              {%- if section.settings.eyebrow != blank -%}
                <p class="revendedor-content__eyebrow">
                  {{ section.settings.eyebrow | escape }}
                </p>
              {%- endif -%}

              {%- if section.settings.heading != blank -%}
                <h2
                  id="RevendedorContent-{{ section.id }}"
                  class="revendedor-content__heading {{ section.settings.heading_size }}"
                >
                  {{ section.settings.heading | escape }}
                </h2>
              {%- endif -%}
            </div>

            <div
              class="revendedor-content__body"
              data-reveal
              style="--reveal-delay: 160ms;"
            >
              {%- if section.settings.text != blank -%}
                <div class="revendedor-content__text rte">
                  {{ section.settings.text }}
                </div>
              {%- endif -%}
            </div>

            {%- if visible_feature_count > 0 -%}
              <div
                class="revendedor-content__features-wrapper"
                data-reveal
                style="--reveal-delay: 240ms;"
              >
                {%- if section.settings.features_heading != blank -%}
                  <p class="revendedor-content__features-title">
                    {{ section.settings.features_heading | escape }}
                  </p>
                {%- endif -%}

                <ul class="revendedor-content__features" role="list">
                  {%- assign feature_index = 0 -%}

                  {%- for block in section.blocks -%}
                    {%- if block.type == 'feature' and block.settings.show_item and block.settings.text != blank -%}
                      {%- assign feature_index = feature_index | plus: 1 -%}
                      {%- assign feature_number = feature_index | prepend: '0' | slice: -2, 2 -%}

                      <li
                        class="revendedor-content__feature"
                        {{ block.shopify_attributes }}
                      >
                        <span
                          class="revendedor-content__feature-number"
                          aria-hidden="true"
                        >
                          {{ feature_number }}
                        </span>

                        <span>
                          {{ block.settings.text | escape }}
                        </span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.secondary_text != blank or show_primary_button or show_secondary_button -%}
              <div
                class="revendedor-content__footer"
                data-reveal
                style="--reveal-delay: 320ms;"
              >
                {%- if section.settings.secondary_text != blank -%}
                  <div class="revendedor-content__note rte">
                    {{ section.settings.secondary_text }}
                  </div>
                {%- endif -%}

                {%- if show_primary_button or show_secondary_button -%}
                  <div class="revendedor-button-group">
                    {%- if show_primary_button -%}
                      <a
                        href="{{ section.settings.button_link }}"
                        class="button button--{{ section.settings.button_style }} focus-inset"
                      >
                        <span>{{ section.settings.button_label | escape }}</span>
                      </a>
                    {%- endif -%}

                    {%- if show_secondary_button -%}
                      <a
                        href="{{ section.settings.secondary_button_link }}"
                        class="button button--{{ section.settings.secondary_button_style }} focus-inset"
                      >
                        <span>{{ section.settings.secondary_button_label | escape }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if media_count > 0 -%}
            <div class="revendedor-content__media-column">
              <div
                class="revendedor-content__media-frame"
                data-reveal="media"
                style="--reveal-delay: 0ms;"
              >
                <div
                  class="revendedor-content__media-grid"
                  data-media-count="{{ media_count }}"
                  aria-label="{{ section.settings.media_label | escape }}"
                >
                  {%- if section.settings.image != blank -%}
                    <figure class="revendedor-content__figure revendedor-content__figure--{{ section.settings.image_ratio }}">
                      {{
                        section.settings.image
                        | image_url: width: 1800
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 550, 750, 990, 1200, 1500, 1800',
                          sizes: '(min-width: 1200px) 40vw, (min-width: 990px) 44vw, (min-width: 750px) 92vw, 100vw',
                          class: 'revendedor-content__image',
                          alt: section.settings.image_alt
                      }}
                    </figure>
                  {%- endif -%}

                  {%- for block in section.blocks -%}
                    {%- if block.type == 'image' and block.settings.image != blank -%}
                      <figure
                        class="revendedor-content__figure revendedor-content__figure--{{ block.settings.image_ratio }}"
                        {{ block.shopify_attributes }}
                      >
                        {{
                          block.settings.image
                          | image_url: width: 1400
                          | image_tag:
                            loading: 'lazy',
                            widths: '360, 550, 750, 990, 1200, 1400',
                            sizes: '(min-width: 990px) 17vw, (min-width: 750px) 46vw, 100vw',
                            class: 'revendedor-content__image',
                            alt: block.settings.image_alt
                        }}
                      </figure>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if section.settings.media_caption != blank -%}
                  <span class="revendedor-content__media-index">
                    {{ section.settings.media_caption | escape }}
                  </span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const section = document.querySelector(
        '#shopify-section-{{ section.id }} [data-revendedor-content]'
      );

      if (!section || section.dataset.revealInitialized === 'true') {
        return;
      }

      section.dataset.revealInitialized = 'true';

      const showSection = () => {
        section.classList.add('is-visible');
      };

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        showSection();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            showSection();
            observer.disconnect();
          });
        },
        {
          threshold: 0.14,
          rootMargin: '0px 0px -8% 0px'
        }
      );

      observer.observe(section);
    })();
  </script>
{%- endif -%}

