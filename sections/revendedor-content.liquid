                #shopify-section-{{ section.id }} .revendedor-content--highlight .revendedor-content__copy,
                #shopify-section-{{ section.id }} .revendedor-content--form .revendedor-content__copy {
                  padding: 2.2rem 1.8rem;
                }
              }

              @media screen and (max-width: 389px) {
                #shopify-section-{{ section.id }} .revendedor-content__container {
                  padding-right: 1.3rem;
                  padding-left: 1.3rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__heading {
                  font-size: 3.1rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__feature {
                  grid-template-columns: 3.7rem minmax(0, 1fr);
