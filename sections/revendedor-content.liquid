{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- liquid
    assign media_count = 0
    if section.settings.show_media
      for block in section.blocks
        if block.type == 'image' and block.settings.image != blank
          assign media_count = media_count | plus: 1
        endif
      endfor
    endif

    assign section_layout = section.settings.layout
    if media_count == 0
      assign section_layout = 'text-only'
    endif
  -%}

  {%- style -%}
    {% render 'section-margin' %}
  {%- endstyle -%}

  <section
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id | handleize }}"
    {% endif %}
    class="revendedor-content revendedor-content--{{ section_layout }} revendedor-content--{{ section.settings.style }} color-{{ section.settings.color_scheme }} background"
    aria-labelledby="RevendedorContent-{{ section.id }}"
  >
    <div class="container">
      <div class="revendedor-content__grid">
        <div class="revendedor-content__copy revendedor-content__copy--{{ section.settings.alignment }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="revendedor-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 id="RevendedorContent-{{ section.id }}" class="revendedor-content__heading title--section title--section-m-none {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="revendedor-content__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.secondary_text != blank -%}
            <div class="revendedor-content__note rte">
              {{ section.settings.secondary_text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank or section.settings.secondary_button_label != blank -%}
            <div class="revendedor-button-group">
              {%- if section.settings.button_label != blank -%}
                <a
                  {% if section.settings.button_link != blank %}
                    href="{{ section.settings.button_link }}"
                  {% else %}
                    aria-disabled="true"
                  {% endif %}
                  class="button button--{{ section.settings.button_style }} focus-inset"
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                </a>
              {%- endif -%}

              {%- if section.settings.secondary_button_label != blank -%}
                <a
                  {% if section.settings.secondary_button_link != blank %}
                    href="{{ section.settings.secondary_button_link }}"
                  {% else %}
                    aria-disabled="true"
                  {% endif %}
                  class="button button--{{ section.settings.secondary_button_style }} focus-inset"
                >
                  <span>{{ section.settings.secondary_button_label | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if media_count > 0 -%}
          <div class="revendedor-content__media-grid" aria-label="{{ section.settings.media_label | escape }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'image' and block.settings.image != blank -%}
                <figure class="revendedor-content__figure revendedor-content__figure--{{ block.settings.image_ratio }}" {{ block.shopify_attributes }}>
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 550, 750, 990, 1200, 1600',
                      sizes: '(min-width: 990px) 38vw, 100vw',
                      class: 'revendedor-content__image',
                      alt: block.settings.image_alt
                  }}
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Revendedor - conteudo",
  "tag": "section",
  "class": "revendedor-content-section spaced-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "default": true,
      "label": "Exibir secao"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID da ancora"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "style",
      "options": [
        {
          "value": "standard",
          "label": "Padrao"
        },
        {
          "value": "highlight",
          "label": "Destaque"
        },
        {
          "value": "compact",
          "label": "Compacta"
        },
        {
          "value": "form",
          "label": "Area de cadastro"
        }
      ],
      "default": "standard",
      "label": "Estilo visual"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "text-only",
          "label": "Somente texto"
        },
        {
          "value": "media-right",
          "label": "Imagem a direita"
        },
        {
          "value": "media-left",
          "label": "Imagem a esquerda"
        }
      ],
      "default": "text-only",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretitulo"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Titulo da secao",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Texto institucional da secao.</p>",
      "label": "Texto principal"
    },
    {
      "type": "richtext",
      "id": "secondary_text",
      "label": "Texto complementar"
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "default": false,
      "label": "Exibir imagens"
    },
    {
      "type": "text",
      "id": "media_label",
      "default": "Imagens da marca AMMIS",
      "label": "Descricao acessivel das imagens"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botao principal"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botao principal"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "secondary",
      "label": "Estilo do botao principal"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Texto do botao secundario"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link do botao secundario"
    },
    {
      "type": "select",
      "id": "secondary_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "simple",
      "label": "Estilo do botao secundario"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagem editorial",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texto alternativo"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {
              "value": "portrait",
              "label": "t:sections.all.image_ratio.options__2.label"
            },
            {
              "value": "landscape",
              "label": "t:sections.all.image_ratio.options__1.label"
            },
            {
              "value": "square",
              "label": "t:sections.all.image_ratio.options__3.label"
            }
          ],
          "default": "portrait",
          "label": "t:sections.steps.settings.image_ratio.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Revendedor - conteudo"
    }
  ]
}
{% endschema %}
