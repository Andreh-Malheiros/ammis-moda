{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- liquid
    assign media_count = 0
    assign visible_feature_count = 0

    if section.settings.show_media
      if section.settings.image != blank
        assign media_count = media_count | plus: 1
      endif

      for block in section.blocks
        if block.type == 'image' and block.settings.image != blank
          assign media_count = media_count | plus: 1
        endif
      endfor
    endif

    for block in section.blocks
      if block.type == 'feature' and block.settings.show_item and block.settings.text != blank
        assign visible_feature_count = visible_feature_count | plus: 1
      endif
    endfor

    assign section_layout = section.settings.layout

    if media_count == 0
      assign section_layout = 'text-only'
    endif

    assign show_primary_button = false
    assign show_secondary_button = false

    if section.settings.button_label != blank and section.settings.button_link != blank
      assign show_primary_button = true
    endif

    if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
      assign show_secondary_button = true
    endif
  -%}

  {%- style -%}
              {% render 'section-margin' %}

              #shopify-section-{{ section.id }} {
                --revendedor-background: rgb(var(--color-background));
                --revendedor-foreground: rgb(var(--color-foreground));
                --revendedor-muted: rgba(var(--color-foreground), 0.67);
                --revendedor-muted-light: rgba(var(--color-foreground), 0.46);
                --revendedor-border: rgba(var(--color-foreground), 0.13);
                --revendedor-border-strong: rgba(var(--color-foreground), 0.25);
                --revendedor-surface: rgba(var(--color-foreground), 0.03);
                --revendedor-dark: #171717;
                --revendedor-light: #ffffff;
              }

              /*
                Estrutura principal
              */

              #shopify-section-{{ section.id }} .revendedor-content {
                position: relative;
                overflow: visible;
              }

              #shopify-section-{{ section.id }} .revendedor-content__container {
                width: 100%;
                max-width: var(--page-width, 144rem);
                margin: 0 auto;
                padding-right: 5rem;
                padding-left: 5rem;
                overflow: visible;
              }

              #shopify-section-{{ section.id }} .revendedor-content__shell {
                position: relative;
                padding: clamp(4.5rem, 5.5vw, 7.5rem) 0;
                overflow: visible;
              }

              #shopify-section-{{ section.id }} .revendedor-content__grid {
                display: grid;
                grid-template-columns: minmax(34rem, 0.9fr) minmax(0, 1.12fr);
                gap: clamp(4rem, 5vw, 7rem);
                align-items: start;
                min-width: 0;
                overflow: visible;
              }

              /*
                Ordem das colunas
              */

              #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__media-column {
                grid-column: 1;
                grid-row: 1;
              }

              #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__copy {
                grid-column: 2;
                grid-row: 1;
              }

              #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-column {
                grid-column: 2;
                grid-row: 1;
              }

              #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__copy {
                grid-column: 1;
                grid-row: 1;
              }

              #shopify-section-{{ section.id }} .revendedor-content--text-only .revendedor-content__grid {
                display: block;
              }

              #shopify-section-{{ section.id }} .revendedor-content--text-only .revendedor-content__copy {
                max-width: 92rem;
                margin: 0 auto;
              }

              /*
                Coluna de imagem com acompanhamento do scroll
              */

              #shopify-section-{{ section.id }} .revendedor-content__media-column {
                position: relative;
                min-width: 0;
                align-self: start;
              }

              @media screen and (min-width: 990px) {
                #shopify-section-{{ section.id }} .revendedor-content__media-column {
                  position: sticky;
                  top: calc(var(--header-height, 7rem) + 2.4rem);
                }
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-frame {
                position: relative;
                min-width: 0;
                padding-bottom: 1.8rem;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-frame::before {
                content: '';
                position: absolute;
                top: 1.6rem;
                right: -1.6rem;
                bottom: 0.2rem;
                left: 1.6rem;
                z-index: 0;
                border: 1px solid var(--revendedor-border);
                pointer-events: none;
              }

              #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-frame::before {
                right: 1.6rem;
                left: -1.6rem;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid {
                position: relative;
                z-index: 1;
                display: grid;
                gap: 1.2rem;
                min-width: 0;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] {
                display: block;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'] {
                grid-template-columns: minmax(0, 1.5fr) minmax(11rem, 0.5fr);
                grid-template-rows: minmax(0, 1fr);
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'],
              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] {
                grid-template-columns: minmax(0, 1.5fr) minmax(11rem, 0.5fr);
                grid-template-rows: repeat(2, minmax(0, 1fr));
              }

              #shopify-section-{{ section.id }} .revendedor-content__figure {
                position: relative;
                min-width: 0;
                min-height: 0;
                margin: 0;
                overflow: hidden;
                background: var(--revendedor-surface);
              }

              #shopify-section-{{ section.id }} .revendedor-content__figure:first-child {
                grid-row: 1 / -1;
              }

              #shopify-section-{{ section.id }} .revendedor-content__figure::after {
                content: '';
                position: absolute;
                inset: 0;
                z-index: 2;
                border: 1px solid rgba(255, 255, 255, 0.08);
                pointer-events: none;
              }

              /*
                Uma imagem: proporção natural, sem corte
              */

          #shopify-section-{{ section.id }} .revendedor-content__media-cta {
            position: relative;
            z-index: 2;
            width: 100%;
            margin-top: 2.4rem;
          }

          #shopify-section-{{ section.id }} .revendedor-content__media-cta .revendedor-content__note {
            width: 100%;
            max-width: none;
          }

          #shopify-section-{{ section.id }} .revendedor-content__media-cta .revendedor-button-group {
            justify-content: flex-start;
          }

          #shopify-section-{{ section.id }} .revendedor-content__media-cta .button {
            min-width: 21rem;
          }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure {
                width: 100%;
                aspect-ratio: auto;
                overflow: visible;
                background: transparent;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__figure::after {
                display: none;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__image {
                width: 100%;
                height: auto;
                max-height: 62rem;
                object-fit: contain;
                object-position: center;
              }

              /*
                Várias imagens
              */

              #shopify-section-{{ section.id }} .revendedor-content__media-grid:not([data-media-count='1']) .revendedor-content__figure--portrait {
                aspect-ratio: 4 / 5;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid:not([data-media-count='1']) .revendedor-content__figure--landscape {
                aspect-ratio: 4 / 3;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid:not([data-media-count='1']) .revendedor-content__figure--square {
                aspect-ratio: 1 / 1;
              }

              #shopify-section-{{ section.id }} .revendedor-content__image {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: {{ section.settings.image_position }};
                transform: scale(1.001);
                transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__image {
                transform: none;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-grid:not([data-media-count='1']):hover .revendedor-content__image {
                transform: scale(1.035);
              }

              /*
                Rodapé editorial abaixo da imagem
              */

              #shopify-section-{{ section.id }} .revendedor-content__media-footer {
                position: relative;
                z-index: 3;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
                margin-top: 1.8rem;
                padding-top: 1.5rem;
                border-top: 1px solid var(--revendedor-border);
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-caption {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin: 0;
                color: var(--revendedor-muted);
                font-size: 1rem;
                font-weight: 500;
                line-height: 1.4;
                letter-spacing: 0.15em;
                text-transform: uppercase;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-caption::before {
                content: '';
                width: 2.8rem;
                height: 1px;
                background: currentColor;
              }

              #shopify-section-{{ section.id }} .revendedor-content__media-number {
                color: var(--revendedor-muted-light);
                font-size: 1rem;
                line-height: 1;
                letter-spacing: 0.12em;
              }

              /*
                Conteúdo
              */

              #shopify-section-{{ section.id }} .revendedor-content__copy {
                position: relative;
                min-width: 0;
                padding: 0;
              }

              #shopify-section-{{ section.id }} .revendedor-content__copy--center {
                text-align: center;
              }

              #shopify-section-{{ section.id }} .revendedor-content__copy--center > * {
                margin-right: auto;
                margin-left: auto;
              }

              #shopify-section-{{ section.id }} .revendedor-content__eyebrow {
                display: flex;
                align-items: center;
                gap: 1.4rem;
                margin: 0 0 1.7rem;
                color: var(--revendedor-muted);
                font-size: 1.05rem;
                font-weight: 500;
                line-height: 1.4;
                letter-spacing: 0.17em;
                text-transform: uppercase;
              }

              #shopify-section-{{ section.id }} .revendedor-content__eyebrow::before {
                content: '';
                display: block;
                width: 3.2rem;
                height: 1px;
                background: var(--revendedor-foreground);
                opacity: 0.6;
              }

              #shopify-section-{{ section.id }} .revendedor-content__copy--center .revendedor-content__eyebrow {
                justify-content: center;
              }

              #shopify-section-{{ section.id }} .revendedor-content__heading {
                max-width: 66rem;
                margin: 0;
                font-size: clamp(3.8rem, 4.2vw, 6.6rem);
                font-weight: 400;
                line-height: 1;
                letter-spacing: -0.045em;
                text-wrap: balance;
              }

              #shopify-section-{{ section.id }} .revendedor-content__text {
                max-width: 64rem;
                margin-top: 2.3rem;
                color: var(--revendedor-muted);
                font-size: 1.5rem;
                line-height: 1.67;
              }

              #shopify-section-{{ section.id }} .revendedor-content__text p,
              #shopify-section-{{ section.id }} .revendedor-content__note p {
                color: inherit;
              }

              #shopify-section-{{ section.id }} .revendedor-content__text > *:first-child,
              #shopify-section-{{ section.id }} .revendedor-content__note > *:first-child {
                margin-top: 0;
              }

              #shopify-section-{{ section.id }} .revendedor-content__text > *:last-child,
              #shopify-section-{{ section.id }} .revendedor-content__note > *:last-child {
                margin-bottom: 0;
              }

              /*
                Lista de benefícios
              */

              #shopify-section-{{ section.id }} .revendedor-content__features-wrapper {
                width: 100%;
                max-width: 68rem;
                margin-top: 2.8rem;
                padding-top: 2rem;
                border-top: 1px solid var(--revendedor-border);
              }

              #shopify-section-{{ section.id }} .revendedor-content__features-title {
                margin: 0 0 1.1rem;
                color: var(--revendedor-foreground);
                font-size: 1.32rem;
                font-weight: 600;
                line-height: 1.4;
              }

              #shopify-section-{{ section.id }} .revendedor-content__features {
                margin: 0;
                padding: 0;
                list-style: none;
              }

              #shopify-section-{{ section.id }} .revendedor-content__feature {
                position: relative;
                display: grid;
                grid-template-columns: 4.3rem minmax(0, 1fr);
                gap: 1.4rem;
                align-items: start;
                padding: 1.3rem 0;
                color: var(--revendedor-foreground);
                border-bottom: 1px solid var(--revendedor-border);
                font-size: 1.38rem;
                line-height: 1.53;
              }

              #shopify-section-{{ section.id }} .revendedor-content__feature::after {
                content: '';
                position: absolute;
                right: 0;
                bottom: -1px;
                left: 0;
                height: 1px;
                background: var(--revendedor-foreground);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
              }

              #shopify-section-{{ section.id }} .revendedor-content__feature:hover::after {
                transform: scaleX(1);
              }

              #shopify-section-{{ section.id }} .revendedor-content__feature-number {
                display: inline-flex;
                align-items: center;
                color: var(--revendedor-muted-light);
                font-size: 1rem;
                font-weight: 500;
                line-height: 1.5;
                letter-spacing: 0.12em;
              }

              #shopify-section-{{ section.id }} .revendedor-content__feature-number::after {
                content: '';
                display: block;
                width: 1.3rem;
                height: 1px;
                margin-left: 0.7rem;
                background: currentColor;
              }

              /*
                Nota e CTA
              */


              #shopify-section-{{ section.id }} .revendedor-content__note {
                padding: 1.7rem 1.9rem;
                color: var(--revendedor-muted);
                background: var(--revendedor-surface);
                border-left: 2px solid var(--revendedor-foreground);
                font-size: 1.34rem;
                line-height: 1.58;
              }

              #shopify-section-{{ section.id }} .revendedor-button-group {
                display: flex;
                flex-wrap: wrap;
                gap: 1.2rem;
                width: 100%;
                margin-top: 2rem;
              }

              #shopify-section-{{ section.id }} .revendedor-button-group .button {
                min-width: 21rem;
                min-height: 5.2rem;
                padding: 1.4rem 2.8rem;
                justify-content: center;
                border-radius: 0;
                font-size: 1.02rem;
                font-weight: 600;
                letter-spacing: 0.11em;
                text-align: center;
                text-transform: uppercase;
                transition:
                  color 280ms ease,
                  background-color 280ms ease,
                  border-color 280ms ease,
                  transform 280ms ease;
              }

              #shopify-section-{{ section.id }} .revendedor-button-group .button:first-child {
                color: var(--revendedor-light);
                background: var(--revendedor-dark);
                border-color: var(--revendedor-dark);
              }

              #shopify-section-{{ section.id }} .revendedor-button-group .button:first-child:hover {
                color: var(--revendedor-dark);
                background: transparent;
                border-color: var(--revendedor-dark);
                transform: translateY(-0.2rem);
              }

              /*
                Estilos existentes
              */

              #shopify-section-{{ section.id }} .revendedor-content--highlight .revendedor-content__copy {
                padding: clamp(3rem, 4vw, 5rem);
                background: var(--revendedor-surface);
                border: 1px solid var(--revendedor-border);
              }

              #shopify-section-{{ section.id }} .revendedor-content--compact .revendedor-content__shell {
                padding-top: clamp(3.5rem, 4.5vw, 5.5rem);
                padding-bottom: clamp(3.5rem, 4.5vw, 5.5rem);
              }

              #shopify-section-{{ section.id }} .revendedor-content--form .revendedor-content__copy {
                padding: clamp(3rem, 4vw, 5rem);
                border: 1px solid var(--revendedor-border);
              }

              /*
                Revelação
              */

              #shopify-section-{{ section.id }} [data-reveal] {
                opacity: 0;
                transform: translateY(2rem);
                transition:
                  opacity 750ms cubic-bezier(0.22, 1, 0.36, 1),
                  transform 750ms cubic-bezier(0.22, 1, 0.36, 1);
                transition-delay: var(--reveal-delay, 0ms);
              }

              #shopify-section-{{ section.id }} [data-reveal='media'] {
                transform: none;
                clip-path: inset(0 0 100% 0);
                transition:
                  opacity 300ms ease,
                  clip-path 1s cubic-bezier(0.22, 1, 0.36, 1);
              }

              #shopify-section-{{ section.id }} .is-visible [data-reveal] {
                opacity: 1;
                transform: translateY(0);
              }

              #shopify-section-{{ section.id }} .is-visible [data-reveal='media'] {
                clip-path: inset(0 0 0 0);
              }

              /*
                Desktop intermediário
              */

              @media screen and (max-width: 1199px) {
                #shopify-section-{{ section.id }} .revendedor-content__container {
                  padding-right: 3.2rem;
                  padding-left: 3.2rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__grid {
                  grid-template-columns: minmax(30rem, 0.88fr) minmax(0, 1.12fr);
                  gap: 4.5rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__heading {
                  font-size: clamp(3.8rem, 4.5vw, 5.8rem);
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__image {
                  max-height: 56rem;
                }
              }

              /*
                Tablet
              */

              @media screen and (max-width: 989px) {
                #shopify-section-{{ section.id }} .revendedor-content__container {
                  padding-right: 2.4rem;
                  padding-left: 2.4rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-column {
      display: contents;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-frame {
      order: 2;
    }

    #shopify-section-{{ section.id }} .revendedor-content__media-cta {
      order: 5;
    }

                #shopify-section-{{ section.id }} .revendedor-content__media-cta {
            margin-top: 0;
          }

                #shopify-section-{{ section.id }} .revendedor-content__shell {
                  padding: 5.5rem 0;
                }

                #shopify-section-{{ section.id }} .revendedor-content__grid,
                #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__grid,
                #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__grid {
                  display: flex;
                  flex-direction: column;
                  gap: 4rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__copy,
                #shopify-section-{{ section.id }} .revendedor-content--media-left .revendedor-content__copy,
                #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__copy {
                  display: contents;
                }

                #shopify-section-{{ section.id }} .revendedor-content__intro {
        order: 1;
      }

      #shopify-section-{{ section.id }} .revendedor-content__media-column {
        order: 2;
      }

      #shopify-section-{{ section.id }} .revendedor-content__body {
        order: 3;
      }

      #shopify-section-{{ section.id }} .revendedor-content__features-wrapper {
        order: 4;
      }

                #shopify-section-{{ section.id }} .revendedor-content__heading {
                  max-width: 72rem;
                  font-size: clamp(4rem, 7vw, 6rem);
                }

                #shopify-section-{{ section.id }} .revendedor-content__text,
                #shopify-section-{{ section.id }} .revendedor-content__features-wrapper,
                #shopify-section-{{ section.id }} .revendedor-content__footer {
                  max-width: 72rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='1'] .revendedor-content__image {
                  width: 100%;
                  max-height: none;
                  height: auto;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'],
                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'],
                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] {
                  grid-template-columns: repeat(2, minmax(0, 1fr));
                  grid-template-rows: auto;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='2'] .revendedor-content__figure:first-child,
                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='3'] .revendedor-content__figure:first-child,
                #shopify-section-{{ section.id }} .revendedor-content__media-grid[data-media-count='4'] .revendedor-content__figure:first-child {
                  grid-column: span 2;
                  grid-row: auto;
                  aspect-ratio: 16 / 10;
                }
              }

              /*
                Mobile
              */

              @media screen and (max-width: 749px) {
                #shopify-section-{{ section.id }} .revendedor-content__container {
                  padding-right: 1.8rem;
                  padding-left: 1.8rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__shell {
                  padding: 4.6rem 0;
                }

                #shopify-section-{{ section.id }} .revendedor-content__grid {
                  gap: 3rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__eyebrow {
                  gap: 1rem;
                  margin-bottom: 1.5rem;
                  font-size: 1rem;
                  letter-spacing: 0.15em;
                }

                #shopify-section-{{ section.id }} .revendedor-content__eyebrow::before {
                  width: 2.4rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__heading {
                  max-width: 35rem;
                  font-size: clamp(3.3rem, 10.2vw, 4.5rem);
                  line-height: 1.02;
                  letter-spacing: -0.04em;
                }

                #shopify-section-{{ section.id }} .revendedor-content__text {
                  margin-top: 2.2rem;
                  font-size: 1.45rem;
                  line-height: 1.68;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-frame {
                  padding-bottom: 1.2rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-frame::before {
                  top: 1.1rem;
                  right: -0.7rem;
                  bottom: 0;
                  left: 1.1rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content--media-right .revendedor-content__media-frame::before {
                  right: 1.1rem;
                  left: -0.7rem;
                }

                #shopify-section-{{ section.id }} .revendedor-content__media-grid,
