{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- style -%}
  {% render 'section-margin' %}

  #shopify-section-{{ section.id }} .revendedor-hero__overlay {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .revendedor-hero {
      min-height: clamp(400px, 36.413vw, 654px);
    }

    #shopify-section-{{ section.id }} .revendedor-hero__media,
    #shopify-section-{{ section.id }} .revendedor-hero__container {
      min-height: inherit;
    }

    #shopify-section-{{ section.id }} .revendedor-hero__image--desktop {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
{%- endstyle -%}

  {%- liquid
    assign show_primary_button = false
    assign show_secondary_button = false

    if section.settings.primary_button_label != blank and section.settings.primary_button_link != blank
      assign show_primary_button = true
    endif

    if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
      assign show_secondary_button = true
    endif
  -%}

  <section class="revendedor-hero{% if section.settings.mobile_image != blank %} revendedor-hero--has-mobile-image{% endif %} color-{{ section.settings.color_scheme }} background" aria-labelledby="RevendedorHero-{{ section.id }}">
    <div class="revendedor-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            widths: '750, 990, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            class: 'revendedor-hero__image revendedor-hero__image--desktop',
            alt: section.settings.image_alt
        }}
      {%- endif -%}

      {%- if section.settings.mobile_image != blank -%}
        {{
          section.settings.mobile_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            widths: '375, 550, 750, 990, 1200',
            sizes: '100vw',
            class: 'revendedor-hero__image revendedor-hero__image--mobile',
            alt: section.settings.mobile_image_alt
        }}
      {%- endif -%}
      <span class="revendedor-hero__overlay" aria-hidden="true"></span>
    </div>

    <div class="container revendedor-hero__container revendedor-hero__container--{{ section.settings.content_position }}">
      <div class="revendedor-hero__content revendedor-hero__content--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="revendedor-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 id="RevendedorHero-{{ section.id }}" class="revendedor-hero__heading title--section title--section-m-none h1">
            {{ section.settings.heading | escape }}
          </h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="revendedor-hero__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if show_primary_button or show_secondary_button -%}
          <div class="revendedor-button-group">
            {%- if show_primary_button -%}
              <a
                href="{{ section.settings.primary_button_link }}"
                class="button button--{{ section.settings.primary_button_style }} focus-inset"
              >
                <span>{{ section.settings.primary_button_label | escape }}</span>
              </a>
            {%- endif -%}

            {%- if show_secondary_button -%}
              <a
                href="{{ section.settings.secondary_button_link }}"
                class="button button--{{ section.settings.secondary_button_style }} focus-inset"
              >
                <span>{{ section.settings.secondary_button_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Revendedor - hero",
  "tag": "section",
  "class": "revendedor-hero-section spaced-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "default": true,
      "label": "Exibir secao"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "PARCERIA COMERCIAL AMMIS",
      "label": "Sobretitulo"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Leve o universo AMMIS para a sua loja",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Faca parte de uma selecao de lojistas conectados a identidade, ao estilo e ao posicionamento da AMMIS. Preencha seu cadastro e apresente sua loja a nossa equipe comercial.</p>",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem desktop"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo da imagem desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile"
    },
    {
      "type": "text",
      "id": "mobile_image_alt",
      "label": "Texto alternativo da imagem mobile"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35,
      "label": "Opacidade do overlay"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Direita"
        }
      ],
      "default": "left",
      "label": "Posicao do conteudo"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "default": "Quero ser revendedor",
      "label": "Texto do botao principal"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link do botao principal"
    },
    {
      "type": "select",
      "id": "primary_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "Estilo do botao principal"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "default": "Conhecer a parceria",
      "label": "Texto do botao secundario"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link do botao secundario"
    },
    {
      "type": "select",
      "id": "secondary_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "tertiary",
      "label": "Estilo do botao secundario"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "Revendedor - hero"
    }
  ]
}
{% endschema %}
