<script src="{{ 'home-sticky-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_id = 'HomeStickyVideo-' | append: section.id
  assign video = section.settings.video
  assign use_fallback_video = false
  assign has_video_source = false
  assign poster_image = section.settings.poster_image
  assign poster_url = ''

  if video != blank
    assign has_video_source = true
  elsif section.settings.enable_fallback_video_url and section.settings.fallback_video_url != blank
    assign use_fallback_video = true
    assign has_video_source = true
  endif

  if poster_image != blank
    assign poster_url = poster_image | image_url: width: 900
  elsif video.preview_image != blank
    assign poster_url = video.preview_image | image_url: width: 900
  endif

  assign destination_url = ''
  case section.settings.destination_type
    when 'product'
      if section.settings.destination_product != blank
        assign destination_url = section.settings.destination_product.url
      endif
    when 'collection'
      if section.settings.destination_collection != blank
        assign destination_url = section.settings.destination_collection.url
      endif
    when 'page'
      if section.settings.destination_page != blank
        assign destination_url = section.settings.destination_page.url
      endif
    when 'custom'
      if section.settings.destination_url != blank
        assign destination_url = section.settings.destination_url
      endif
  endcase

  assign shadow_alpha = section.settings.shadow_intensity | divided_by: 100.0
  assign backdrop_alpha = section.settings.backdrop_opacity | divided_by: 100.0
-%}

{%- if section.settings.enable_widget and has_video_source -%}
  <home-sticky-video
    id="{{ section_id }}"
    class="home-sticky-video home-sticky-video--{{ section.settings.position_side }}"
    data-section-id="{{ section.id }}"
    data-destination-url="{{ destination_url | escape }}"
    data-copy-message="{{ section.settings.copy_message | escape }}"
    data-save-favorite="{{ section.settings.save_favorite }}"
    data-close-on-backdrop="{{ section.settings.close_on_backdrop }}"
    data-close-on-escape="{{ section.settings.close_on_escape }}"
    style="
      --hsv-circle-desktop: {{ section.settings.circle_size_desktop }}px;
      --hsv-circle-mobile: {{ section.settings.circle_size_mobile }}px;
      --hsv-expanded-desktop: {{ section.settings.expanded_width_desktop }}px;
      --hsv-expanded-mobile: {{ section.settings.expanded_width_mobile }}px;
      --hsv-offset-x-desktop: {{ section.settings.offset_x_desktop }}px;
      --hsv-offset-y-desktop: {{ section.settings.offset_y_desktop }}px;
      --hsv-offset-x-mobile: {{ section.settings.offset_x_mobile }}px;
      --hsv-offset-y-mobile: {{ section.settings.offset_y_mobile }}px;
      --hsv-radius: {{ section.settings.expanded_radius }}px;
      --hsv-border-width: {{ section.settings.border_width }}px;
      --hsv-border-color: {{ section.settings.border_color }};
      --hsv-button-bg: {{ section.settings.button_background }};
      --hsv-icon-color: {{ section.settings.icon_color }};
      --hsv-cta-bg: {{ section.settings.cta_background }};
      --hsv-cta-color: {{ section.settings.cta_text_color }};
      --hsv-shadow-alpha: {{ shadow_alpha }};
      --hsv-backdrop-alpha: {{ backdrop_alpha }};
      --hsv-z-index: {{ section.settings.z_index }};
    "
  >
    <div class="home-sticky-video__backdrop" hidden aria-hidden="true" data-sticky-video-backdrop></div>

    <div
      id="{{ section_id }}-panel"
      class="home-sticky-video__panel"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="{{ section.settings.accessible_description | default: 'Vídeo AMMIS' | escape }}"
      tabindex="-1"
      data-sticky-video-panel
    >
      <div class="home-sticky-video__media">
        {%- if video != blank -%}
          {{
            video
            | video_tag:
              class: 'home-sticky-video__video',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              poster: poster_url
          }}
        {%- elsif use_fallback_video -%}
          <video
            class="home-sticky-video__video"
            src="{{ section.settings.fallback_video_url | escape }}"
            {% if poster_url != blank %}
              poster="{{ poster_url }}"
            {% endif %}
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
          ></video>
        {%- endif -%}
      </div>

      <button class="home-sticky-video__close" type="button" aria-label="Fechar vídeo" data-sticky-video-close>
        <span aria-hidden="true">{% render 'icon-close' %}</span>
      </button>

      <div class="home-sticky-video__bottom">
        {%- if section.settings.show_cta and section.settings.cta_text != blank and destination_url != blank -%}
          <a
            class="home-sticky-video__cta home-sticky-video__cta--{{ section.settings.cta_position }}"
            href="{{ destination_url }}"
            {% if section.settings.cta_new_tab %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
            data-sticky-video-cta
          >
            {{ section.settings.cta_text | escape }}
          </a>
        {%- endif -%}

        <div class="home-sticky-video__controls" aria-label="Controles do vídeo">
          {%- if section.settings.show_sound -%}
            <button class="home-sticky-video__control" type="button" aria-label="Ativar som" aria-pressed="false" data-sticky-video-sound>
              <span class="home-sticky-video__icon home-sticky-video__icon--sound-off" aria-hidden="true">{% render 'icon-sound-off' %}</span>
              <span class="home-sticky-video__icon home-sticky-video__icon--sound-on" aria-hidden="true" hidden>{% render 'icon-sound-on' %}</span>
            </button>
          {%- endif -%}

          {%- if section.settings.show_share -%}
            <button class="home-sticky-video__control" type="button" aria-label="Compartilhar" data-sticky-video-share>
              <span aria-hidden="true">{% render 'icon-share' %}</span>
            </button>
          {%- endif -%}

          {%- if section.settings.show_favorite -%}
            <button class="home-sticky-video__control" type="button" aria-label="Favoritar vídeo" aria-pressed="false" data-sticky-video-favorite>
              <svg class="home-sticky-video__heart" viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12 20.6 4.7 13.4C2.8 11.5 2.8 8.5 4.6 6.7c1.8-1.8 4.7-1.8 6.5 0l.9.9.9-.9c1.8-1.8 4.7-1.8 6.5 0 1.8 1.8 1.8 4.8-.1 6.7L12 20.6Z" />
              </svg>
            </button>
          {%- endif -%}
        </div>
      </div>

      <p class="home-sticky-video__feedback" aria-live="polite" hidden data-sticky-video-feedback>
        {{ section.settings.copy_message | default: 'Link copiado' | escape }}
      </p>
    </div>

    <button
      class="home-sticky-video__trigger"
      type="button"
      aria-label="{{ section.settings.accessible_description | default: 'Expandir vídeo AMMIS' | escape }}"
      aria-expanded="false"
      aria-controls="{{ section_id }}-panel"
      data-sticky-video-trigger
    ></button>
  </home-sticky-video>
{%- elsif request.design_mode and section.settings.enable_widget -%}
  <div class="home-sticky-video-placeholder">
    Selecione um vídeo nas configurações desta seção.
  </div>
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .home-sticky-video {
    position: fixed;
    bottom: calc(var(--hsv-offset-y-desktop) + env(safe-area-inset-bottom, 0px));
    z-index: var(--hsv-z-index);
    display: block;
    width: var(--hsv-circle-desktop);
    height: var(--hsv-circle-desktop);
    color: var(--hsv-icon-color);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .home-sticky-video--left {
    left: var(--hsv-offset-x-desktop);
  }

  #shopify-section-{{ section.id }} .home-sticky-video--right {
    right: var(--hsv-offset-x-desktop);
  }

  #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] {
    inset: 0;
    width: auto;
    height: auto;
    display: grid;
    place-items: center;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(0, 0, 0, var(--hsv-backdrop-alpha));
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__panel {
    position: relative;
    z-index: 1;
    width: var(--hsv-circle-desktop);
    height: var(--hsv-circle-desktop);
    max-width: calc(100vw - (2 * var(--hsv-offset-x-desktop)));
    max-height: calc(100dvh - (2 * var(--hsv-offset-y-desktop)) - env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    border: var(--hsv-border-width) solid var(--hsv-border-color);
    border-radius: 50%;
    background: #000;
    box-shadow: 0 12px 32px rgba(0, 0, 0, var(--hsv-shadow-alpha));
    pointer-events: auto;
    transition: width var(--duration-default), height var(--duration-default), border-radius var(--duration-default), transform var(--duration-default), opacity var(--duration-default);
  }

  #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__panel {
    width: min(var(--hsv-expanded-desktop), calc(100vw - (2 * var(--hsv-offset-x-desktop))));
    height: auto;
    aspect-ratio: 9 / 16;
    max-height: min(calc(100dvh - 48px - env(safe-area-inset-bottom, 0px)), 760px);
    border-radius: var(--hsv-radius);
    box-shadow: 0 18px 56px rgba(0, 0, 0, var(--hsv-shadow-alpha));
  }

  #shopify-section-{{ section.id }} .home-sticky-video__media,
  #shopify-section-{{ section.id }} .home-sticky-video__video {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__video {
    object-fit: cover;
    background: #000;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__video::-webkit-media-controls {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__trigger {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: var(--hsv-border-width) solid transparent;
    border-radius: 50%;
    cursor: pointer;
    background: transparent;
    pointer-events: auto;
    transition: opacity var(--duration-default), transform var(--duration-default);
  }

  #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__trigger {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }

  #shopify-section-{{ section.id }} .home-sticky-video__close,
  #shopify-section-{{ section.id }} .home-sticky-video__control {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--hsv-icon-color);
    background: var(--hsv-button-bg);
    cursor: pointer;
    transition: transform var(--duration-short), background var(--duration-short);
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 4;
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__close {
    opacity: 1;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__close svg,
  #shopify-section-{{ section.id }} .home-sticky-video__control svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__close svg path,
  #shopify-section-{{ section.id }} .home-sticky-video__close svg circle,
  #shopify-section-{{ section.id }} .home-sticky-video__close svg rect,
  #shopify-section-{{ section.id }} .home-sticky-video__control svg path,
  #shopify-section-{{ section.id }} .home-sticky-video__control svg circle,
  #shopify-section-{{ section.id }} .home-sticky-video__control svg rect {
    stroke: currentColor;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__bottom {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
    padding: 72px 14px 14px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.68), rgba(0, 0, 0, 0));
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__bottom {
    opacity: 1;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__controls {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__heart path {
    fill: transparent;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: fill var(--duration-short);
  }

  #shopify-section-{{ section.id }} .home-sticky-video__control[aria-pressed="true"] .home-sticky-video__heart path {
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__trigger:focus-visible,
  #shopify-section-{{ section.id }} .home-sticky-video__close:focus-visible,
  #shopify-section-{{ section.id }} .home-sticky-video__control:focus-visible,
  #shopify-section-{{ section.id }} .home-sticky-video__cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__close:hover,
  #shopify-section-{{ section.id }} .home-sticky-video__control:hover {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .home-sticky-video__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    max-width: 100%;
    padding: 0 18px;
    border-radius: 4px;
    color: var(--hsv-cta-color);
    background: var(--hsv-cta-bg);
    font-size: 1.3rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    word-break: break-word;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__cta--bottom-left {
    align-self: flex-start;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__cta--bottom-center {
    align-self: center;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__cta--bottom-right {
    align-self: flex-end;
  }

  #shopify-section-{{ section.id }} .home-sticky-video__feedback {
    position: absolute;
    left: 50%;
    bottom: 92px;
    z-index: 5;
    margin: 0;
    padding: 8px 12px;
    border-radius: 4px;
    color: var(--hsv-cta-color);
    background: var(--hsv-cta-bg);
    font-size: 1.2rem;
    line-height: 1.2;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .home-sticky-video-placeholder {
    margin: 24px;
    padding: 16px;
    border: 1px dashed rgba(var(--color-foreground), 0.25);
    color: rgb(var(--color-foreground-secondary));
    background: rgba(var(--color-foreground), 0.03);
    font-size: 1.3rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .home-sticky-video {
      bottom: calc(var(--hsv-offset-y-mobile) + env(safe-area-inset-bottom, 0px));
      width: var(--hsv-circle-mobile);
      height: var(--hsv-circle-mobile);
    }

    #shopify-section-{{ section.id }} .home-sticky-video--left {
      left: var(--hsv-offset-x-mobile);
    }

    #shopify-section-{{ section.id }} .home-sticky-video--right {
      right: var(--hsv-offset-x-mobile);
    }

    #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] {
      inset: 0;
      width: 100vw;
      height: 100dvh;
      display: block;
    }

    #shopify-section-{{ section.id }} .home-sticky-video__panel {
      width: var(--hsv-circle-mobile);
      height: var(--hsv-circle-mobile);
      max-width: calc(100vw - (2 * var(--hsv-offset-x-mobile)));
      max-height: calc(100dvh - (2 * var(--hsv-offset-y-mobile)) - env(safe-area-inset-bottom, 0px));
    }

    #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__panel {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      max-width: none;
      max-height: none;
      aspect-ratio: auto;
      border-width: 0;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .home-sticky-video__close {
      top: calc(12px + env(safe-area-inset-top, 0px));
      right: calc(12px + env(safe-area-inset-right, 0px));
    }

    #shopify-section-{{ section.id }} .home-sticky-video__bottom {
      padding-right: calc(14px + env(safe-area-inset-right, 0px));
      padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      padding-left: calc(14px + env(safe-area-inset-left, 0px));
    }

    #shopify-section-{{ section.id }} .home-sticky-video__close,
    #shopify-section-{{ section.id }} .home-sticky-video__control {
      width: 44px;
      height: 44px;
    }
  }

  @supports not (height: 100dvh) {
    #shopify-section-{{ section.id }} .home-sticky-video__panel {
      max-height: calc(100vh - (2 * var(--hsv-offset-y-desktop)));
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"],
      #shopify-section-{{ section.id }} .home-sticky-video[data-expanded="true"] .home-sticky-video__panel {
        height: 100vh;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .home-sticky-video__trigger,
    #shopify-section-{{ section.id }} .home-sticky-video__panel,
    #shopify-section-{{ section.id }} .home-sticky-video__close,
    #shopify-section-{{ section.id }} .home-sticky-video__control {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Vídeo flutuante AMMIS",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "checkbox",
      "id": "enable_widget",
      "label": "Ativar widget",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "A Shopify aceita upload de MOV, MP4 e WEBM em Conteúdo > Arquivos. O arquivo precisa terminar de ser processado pela Shopify antes de aparecer como vídeo selecionável."
    },
    {
      "type": "paragraph",
      "content": "A Shopify converte e entrega o vídeo em formatos compatíveis, como MP4 ou HLS. Caso um MOV não seja aceito, exporte como MP4 com codec H.264 e áudio AAC."
    },
    {
      "type": "paragraph",
      "content": "Formato visual recomendado: vertical 9:16. Dimensão recomendada: 1080 × 1920 px."
    },
    {
      "type": "paragraph",
      "content": "O vídeo será recortado com preenchimento total. Mantenha textos e elementos importantes afastados das bordas. Para melhor desempenho, use um arquivo otimizado e de curta duração."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo"
    },
    {
      "type": "checkbox",
      "id": "enable_fallback_video_url",
      "label": "Usar URL alternativa de vídeo",
      "default": false
    },
    {
      "type": "url",
      "id": "fallback_video_url",
      "label": "URL alternativa do vídeo"
    },
    {
      "type": "paragraph",
      "content": "Use preferencialmente uma URL direta para arquivo MP4 compatível com navegadores. O vídeo selecionado no campo principal tem prioridade."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Imagem de capa"
    },
    {
      "type": "text",
      "id": "accessible_description",
      "label": "Descrição acessível do vídeo",
      "default": "Vídeo da AMMIS"
    },
    {
      "type": "select",
      "id": "destination_type",
      "label": "Tipo de destino",
      "default": "none",
      "options": [
        { "value": "none", "label": "Nenhum" },
        { "value": "product", "label": "Produto" },
        { "value": "collection", "label": "Coleção" },
        { "value": "page", "label": "Página" },
        { "value": "custom", "label": "Link personalizado" }
      ]
    },
    {
      "type": "product",
      "id": "destination_product",
      "label": "Produto"
    },
    {
      "type": "collection",
      "id": "destination_collection",
      "label": "Coleção"
    },
    {
      "type": "page",
      "id": "destination_page",
      "label": "Página"
    },
    {
      "type": "url",
      "id": "destination_url",
      "label": "Link personalizado"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Exibir CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto do CTA",
      "default": "Ver agora"
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Abrir CTA em nova aba",
      "default": false
    },
    {
      "type": "select",
      "id": "cta_position",
      "label": "Posição do CTA",
      "default": "bottom-center",
      "options": [
        { "value": "bottom-left", "label": "Inferior esquerda" },
        { "value": "bottom-center", "label": "Inferior centro" },
        { "value": "bottom-right", "label": "Inferior direita" }
      ]
    },
    {
      "type": "header",
      "content": "Controles"
    },
    {
      "type": "checkbox",
      "id": "show_favorite",
      "label": "Exibir botão de favorito",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Exibir botão de compartilhar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sound",
      "label": "Exibir botão de som",
      "default": true
    },
    {
      "type": "text",
