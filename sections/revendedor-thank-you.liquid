{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- liquid
    assign section_layout = section.settings.layout
    if section.settings.image == blank
      assign section_layout = 'text-only'
    endif

    assign show_primary_button = false
    assign show_secondary_button = false

    if section.settings.button_label != blank and section.settings.button_link != blank
      assign show_primary_button = true
    endif

    if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
      assign show_secondary_button = true
    endif
  -%}

  {%- style -%}
    {% render 'section-margin' %}
  {%- endstyle -%}

  <section class="revendedor-content revendedor-content--{{ section_layout }} revendedor-content--confirmation color-{{ section.settings.color_scheme }} background" aria-labelledby="RevendedorThankYou-{{ section.id }}">
    <div class="container">
      <div class="revendedor-content__grid">
        <div class="revendedor-content__copy revendedor-content__copy--{{ section.settings.alignment }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="revendedor-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h1 id="RevendedorThankYou-{{ section.id }}" class="revendedor-content__heading title--section title--section-m-none h1">
              {{ section.settings.heading | escape }}
            </h1>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="revendedor-content__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if show_primary_button or show_secondary_button -%}
            <div class="revendedor-button-group">
              {%- if show_primary_button -%}
                <a
                  href="{{ section.settings.button_link }}"
                  class="button button--{{ section.settings.button_style }} focus-inset"
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                </a>
              {%- endif -%}

              {%- if show_secondary_button -%}
                <a
                  href="{{ section.settings.secondary_button_link }}"
                  class="button button--{{ section.settings.secondary_button_style }} focus-inset"
                >
                  <span>{{ section.settings.secondary_button_label | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.image != blank -%}
          <div class="revendedor-content__media-grid" aria-label="{{ section.settings.image_alt | escape }}">
            <figure class="revendedor-content__figure revendedor-content__figure--portrait">
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 550, 750, 990, 1200, 1600',
                  sizes: '(min-width: 990px) 38vw, 100vw',
                  class: 'revendedor-content__image',
                  alt: section.settings.image_alt
              }}
            </figure>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Revendedor - confirmacao",
  "tag": "section",
  "class": "revendedor-page-section spaced-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "default": true,
      "label": "Exibir secao"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "text-only",
          "label": "Somente texto"
        },
        {
          "value": "media-right",
          "label": "Imagem a direita"
        },
        {
          "value": "media-left",
          "label": "Imagem a esquerda"
        }
      ],
      "default": "text-only",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "CADASTRO RECEBIDO",
      "label": "Sobretitulo"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Recebemos suas informacoes",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Nossa equipe analisara o cadastro e entrara em contato caso haja alinhamento com o perfil comercial da AMMIS.</p>",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem opcional"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo da imagem"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Voltar para a loja",
      "label": "Texto do botao principal"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botao principal"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "secondary",
      "label": "Estilo do botao principal"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Texto do botao secundario"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link do botao secundario"
    },
    {
      "type": "select",
      "id": "secondary_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "simple",
      "label": "Estilo do botao secundario"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "Revendedor - confirmacao"
    }
  ]
}
{% endschema %}
