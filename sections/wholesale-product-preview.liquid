{%- assign preview_collection = section.settings.collection -%}

<section class="wholesale-product-preview" aria-label="Prévia do catálogo de atacado">
  <div class="wholesale-product-preview__inner">
    {%- if section.settings.catalog_pdf != blank -%}
      <div class="wholesale-product-preview__download-wrap">
        <a
          class="wholesale-product-preview__button wholesale-product-preview__button--download"
          href="{{ section.settings.catalog_pdf | escape }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Baixar catálogo</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" focusable="false">
            <path d="M10 2.5v9m0 0 3.5-3.5M10 11.5 6.5 8M3.5 13.5v3h13v-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

    {%- if preview_collection != blank and preview_collection.products_count > 0 -%}
      <div class="wholesale-product-preview__grid">
        {%- for product in preview_collection.products limit: 16 -%}
          <article class="wholesale-product-preview__card">
            <a class="wholesale-product-preview__image-link" href="{{ product.url }}" aria-label="Ver {{ product.title | escape }}">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 720
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 720',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                    class: 'wholesale-product-preview__image',
                    alt: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'wholesale-product-preview__image wholesale-product-preview__placeholder' }}
              {%- endif -%}
            </a>

            <h2 class="wholesale-product-preview__title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h2>
            <p class="wholesale-product-preview__price">{{ product.price | money }}</p>
          </article>
        {%- endfor -%}
      </div>

      <div class="wholesale-product-preview__more-wrap">
        <a
          class="wholesale-product-preview__button wholesale-product-preview__button--more"
          href="#catalogo-atacado"
          aria-label="Ver mais produtos no catálogo completo"
        >
          Ver mais produtos
        </a>
      </div>
    {%- else -%}
      <p class="wholesale-product-preview__empty">Selecione uma coleção para exibir os produtos.</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .wholesale-product-preview {
    padding: 0 2rem 5rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__inner {
    width: 100%;
    max-width: 144rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__download-wrap,
  #shopify-section-{{ section.id }} .wholesale-product-preview__more-wrap {
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__download-wrap {
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.4rem 1.8rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #f5f3f0;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__image-link:hover .wholesale-product-preview__image {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__title {
    margin: 1.2rem 0 0.5rem;
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__price {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button {
    display: inline-flex;
    min-height: 5.2rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.4rem 2.4rem;
    border: 1px solid #171717;
    background: #171717;
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button:hover {
    background: #fff;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button--download svg {
    width: 2rem;
    height: 2rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__more-wrap {
    margin-top: 3rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__empty {
    margin: 0;
    padding: 3rem 0;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-product-preview {
      padding: 0 1rem 4rem;
    }

    #shopify-section-{{ section.id }} .wholesale-product-preview__grid {
      gap: 2rem 1rem;
    }

    #shopify-section-{{ section.id }} .wholesale-product-preview__title {
      font-size: 1.3rem;
    }

    #shopify-section-{{ section.id }} .wholesale-product-preview__button {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Prévia catálogo atacado",
  "tag": "section",
  "class": "wholesale-product-preview-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção de produtos"
    },
    {
      "type": "url",
      "id": "catalog_pdf",
      "label": "Arquivo PDF do catálogo"
    }
  ],
  "presets": [
    {
      "name": "Prévia catálogo atacado"
    }
  ]
}
{% endschema %}
