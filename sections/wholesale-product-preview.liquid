{%- assign preview_collection = section.settings.collection -%}

<section class="wholesale-product-preview" aria-label="Prévia do catálogo de atacado">
  <div class="wholesale-product-preview__inner">
    {%- if section.settings.catalog_pdf != blank -%}
      <div class="wholesale-product-preview__download-wrap">
        <a
          class="wholesale-product-preview__button wholesale-product-preview__button--download"
          href="{{ section.settings.catalog_pdf | escape }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Baixar catálogo</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" focusable="false">
            <path d="M10 2.5v9m0 0 3.5-3.5M10 11.5 6.5 8M3.5 13.5v3h13v-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

    {%- if preview_collection != blank and preview_collection.products_count > 0 -%}
      <div class="wholesale-product-preview__grid">
        {%- for product in preview_collection.products limit: 8 -%}
          {% render 'wholesale-product-card', product: product, card_id: section.id %}
        {%- endfor -%}
      </div>

      <div class="wholesale-product-preview__more-wrap">
        <a
          class="wholesale-product-preview__button wholesale-product-preview__button--more"
          href="#catalogo-atacado"
          aria-label="Ver mais produtos no catálogo completo"
        >
          Ver mais produtos
        </a>
      </div>
    {%- else -%}
      <p class="wholesale-product-preview__empty">Selecione uma coleção para exibir os produtos.</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .wholesale-product-preview {
    padding: 0 2rem 5rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__inner {
    width: 100%;
    max-width: 144rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__download-wrap,
  #shopify-section-{{ section.id }} .wholesale-product-preview__more-wrap {
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__download-wrap {
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.4rem 1.8rem;
  }


  #shopify-section-{{ section.id }} .wholesale-product-preview__button {
    display: inline-flex;
    min-height: 5.2rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.4rem 2.4rem;
    border: 1px solid #171717;
    background: #171717;
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button:hover {
    background: #fff;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button--download {
    width: min(100%, 44rem);
    min-height: 8rem;
    padding: 2rem 3.2rem;
    border-width: 2px;
    font-size: 1.6rem;
    font-weight: 700;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__button--download svg {
    width: 2rem;
    height: 2rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__more-wrap {
    margin-top: 3rem;
  }

  #shopify-section-{{ section.id }} .wholesale-product-preview__empty {
    margin: 0;
    padding: 3rem 0;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-product-preview {
      padding: 0 1rem 4rem;
    }

    #shopify-section-{{ section.id }} .wholesale-product-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }


    #shopify-section-{{ section.id }} .wholesale-product-preview__grid > .b2b-card:nth-child(n + 5) {
      display: none;
    }

    #shopify-section-{{ section.id }} .wholesale-product-preview__button {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Prévia catálogo atacado",
  "tag": "section",
  "class": "wholesale-product-preview-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção de produtos"
    },
    {
      "type": "url",
      "id": "catalog_pdf",
      "label": "Arquivo PDF do catálogo"
    }
  ],
  "presets": [
    {
      "name": "Prévia catálogo atacado"
    }
  ]
}
{% endschema %}
