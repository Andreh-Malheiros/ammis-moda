{%- liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.mobile_image != blank
    assign hero_image = section.settings.mobile_image
  endif
-%}

<section
  id="wholesale-hero"
  class="wholesale-hero wholesale-hero--align-{{ section.settings.content_alignment }} wholesale-hero--position-{{ section.settings.content_position }} wholesale-hero--{{ section.settings.text_tone }}{% if hero_image != blank %} wholesale-hero--has-image{% else %} wholesale-hero--no-image{% endif %}"
  style="--wholesale-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if hero_image != blank -%}
    <div class="wholesale-hero__media">
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 1400 }}"
          >
        {%- endif -%}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 990, 1200, 1500, 1800, 2200, 2400',
            sizes: '100vw',
            class: 'wholesale-hero__image',
            alt: section.settings.image_alt
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="wholesale-hero__overlay" aria-hidden="true"></div>

  <div class="wholesale-hero__inner">
    <div class="wholesale-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wholesale-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="wholesale-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wholesale-hero__text">{{ section.settings.text | escape }}</div>
      {%- endif -%}

      <div class="wholesale-hero__actions" aria-label="Acessos do atacado AMMIS">
        {%- if section.settings.primary_button_label != blank -%}
          {%- if section.settings.primary_button_link != blank -%}
            <a class="wholesale-hero__cta wholesale-hero__cta--primary" href="{{ section.settings.primary_button_link | escape }}">
              {{ section.settings.primary_button_label | escape }}
            </a>
          {%- else -%}
            <span class="wholesale-hero__cta wholesale-hero__cta--primary wholesale-hero__cta--disabled" aria-disabled="true">
              {{ section.settings.primary_button_label | escape }}
            </span>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.commercial_button_label != blank -%}
          {%- if section.settings.commercial_button_link != blank -%}
            <a class="wholesale-hero__cta wholesale-hero__cta--secondary" href="{{ section.settings.commercial_button_link | escape }}">
              {{ section.settings.commercial_button_label | escape }}
            </a>
          {%- else -%}
            <span class="wholesale-hero__cta wholesale-hero__cta--secondary wholesale-hero__cta--disabled" aria-disabled="true">
              {{ section.settings.commercial_button_label | escape }}
            </span>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.partnership_button_label != blank -%}
          <a class="wholesale-hero__cta wholesale-hero__cta--tertiary" href="#parceria-ammis">
            {{ section.settings.partnership_button_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .wholesale-hero {
    --wholesale-hero-content-width: 72rem;
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(48rem, 68vh, 76rem);
    overflow: hidden;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .wholesale-hero__media,
  #shopify-section-{{ section.id }} .wholesale-hero__overlay {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__media {
    z-index: -2;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__media picture,
  #shopify-section-{{ section.id }} .wholesale-hero__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__overlay {
    z-index: -1;
    background: rgba(0, 0, 0, var(--wholesale-hero-overlay));
  }

  #shopify-section-{{ section.id }} .wholesale-hero__inner {
    display: flex;
    width: 100%;
    max-width: 144rem;
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 11rem) clamp(2rem, 6vw, 8rem);
  }

  #shopify-section-{{ section.id }} .wholesale-hero__content {
    display: flex;
    flex-direction: column;
    width: min(100%, var(--wholesale-hero-content-width));
    gap: 0;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--align-left .wholesale-hero__inner {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--align-center .wholesale-hero__inner {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--align-right .wholesale-hero__inner {
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--position-top .wholesale-hero__inner {
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--position-center .wholesale-hero__inner {
    align-items: center;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--position-bottom .wholesale-hero__inner {
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--align-center .wholesale-hero__content {
    text-align: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--align-right .wholesale-hero__content {
    text-align: right;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__eyebrow {
    margin: 0 0 1.8rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__heading {
    max-width: 68rem;
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 6vw, 7.2rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--font-heading-letter-spacing);
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__text {
    max-width: 54rem;
    margin-top: 2.2rem;
    font-size: clamp(1.5rem, 1.8vw, 1.9rem);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 1.6rem;
    margin-top: 3.2rem;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: center;
    padding: 1.3rem 2rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta:hover {
    opacity: 0.78;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--light {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--dark {
    color: #171717;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--no-image.wholesale-hero--light {
    background: #171717;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--no-image.wholesale-hero--dark {
    background: #fff;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--light .wholesale-hero__cta--primary {
    background: #fff;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .wholesale-hero--dark .wholesale-hero__cta--primary {
    background: #171717;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta--secondary {
    border-color: currentColor;
    background: transparent;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta--tertiary {
    gap: 0.8rem;
    min-height: auto;
    padding-right: 0;
    padding-left: 0;
    border-color: transparent;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta--tertiary span {
    font-size: 1.7rem;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .wholesale-hero__cta--disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wholesale-hero {
      min-height: 62rem;
    }

    #shopify-section-{{ section.id }} .wholesale-hero__inner {
      padding: 6rem 2rem 5rem;
    }

    #shopify-section-{{ section.id }} .wholesale-hero__content,
    #shopify-section-{{ section.id }} .wholesale-hero--align-right .wholesale-hero__content {
      align-items: flex-start;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .wholesale-hero__actions {
      width: 100%;
      align-items: stretch;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .wholesale-hero__cta {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .wholesale-hero__cta--tertiary {
      width: auto;
      align-self: flex-start;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero Atacado AMMIS",
  "tag": "section",
  "class": "wholesale-hero-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Identificação",
      "default": "ATACADO AMMIS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Parceria comercial AMMIS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto de apoio",
      "default": "Conheça a experiência de atacado e escolha o melhor caminho para sua loja."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile",
      "info": "Se ficar vazio, a imagem desktop será usada no mobile."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo da imagem",
      "default": "Atacado AMMIS"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Intensidade do overlay",
      "default": 35
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Tom do texto",
      "default": "light",
      "options": [
        { "value": "light", "label": "Claro" },
        { "value": "dark", "label": "Escuro" }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alinhamento horizontal",
      "default": "left",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posição vertical",
      "default": "center",
      "options": [
        { "value": "top", "label": "Topo" },
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Base" }
      ]
    },
    {
      "type": "header",
      "content": "Acessos comerciais"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Texto: Quero me cadastrar",
      "default": "Quero me cadastrar"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link: Quero me cadastrar",
      "info": "Deixe vazio até confirmar a página de destino."
    },
    {
      "type": "text",
      "id": "commercial_button_label",
      "label": "Texto: Falar com o comercial",
      "default": "Falar com o comercial"
    },
    {
      "type": "url",
      "id": "commercial_button_link",
      "label": "Link: Falar com o comercial",
      "info": "Configure o destino comercial quando o link oficial estiver definido."
    },
    {
      "type": "text",
      "id": "partnership_button_label",
      "label": "Texto: Conhecer a parceria",
      "default": "Conhecer a parceria"
    }
  ],
  "presets": [
    {
      "name": "Hero Atacado AMMIS"
    }
  ]
}
{% endschema %}
