{{ 'section-revendedor-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_section -%}
  {%- style -%}
    {% render 'section-margin' %}
  {%- endstyle -%}

  <section class="revendedor-steps color-{{ section.settings.color_scheme }} background" aria-labelledby="RevendedorSteps-{{ section.id }}">
    <div class="container">
      <div class="revendedor-section-heading revendedor-section-heading--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="revendedor-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="RevendedorSteps-{{ section.id }}" class="title--section title--section-m-none {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </div>

      <ol class="revendedor-step-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' and block.settings.show_item -%}
            <li class="revendedor-step" {{ block.shopify_attributes }}>
              <span class="revendedor-step__number">{{ forloop.index }}</span>
              <div class="revendedor-step__copy">
                {%- if block.settings.heading != blank -%}
                  <h3 class="revendedor-step__heading h3">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="revendedor-step__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Revendedor - etapas",
  "tag": "section",
  "class": "revendedor-steps-section spaced-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "default": true,
      "label": "Exibir secao"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretitulo"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Como funciona o cadastro",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Etapa",
      "limit": 8,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_item",
          "default": true,
          "label": "Exibir etapa"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Titulo da etapa",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Descreva a etapa.</p>",
          "label": "t:sections.all.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Revendedor - etapas"
    }
  ]
}
{% endschema %}
