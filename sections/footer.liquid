					{%- if section.settings.enable_country_selector
						or section.settings.enable_language_selector
						or section.settings.payment_enable
					-%}
						<div class='footer__content-middle'>
							<div class='container'>
								<div class='footer__content-middle-container'>
									<div class='footer__content-middle-main'>
										{%- if section.settings.payment_enable -%}
											<div class='footer__column footer__column--payment'>
												<div class='footer__payment'>
													<ul class='list list-payment' role='list'>
														{%- for type in shop.enabled_payment_types -%}
															<li class='list-payment__item'>
																{{
																	type
																	| payment_type_svg_tag:
																		class: 'icon icon--full-color'
																}}
															</li>
														{%- endfor -%}
													</ul>
												</div>
											</div>
										{%- endif -%}
										{%- if section.settings.enable_country_selector
											or section.settings.enable_language_selector
										-%}
											<div class='footer__column footer__column--localization'>
												{% render 'header-region', section: section %}
											</div>
										{%- endif -%}
									</div>
								</div>
							</div>
						</div>
					{% endif %}

					{%- if shop.features.follow_on_shop?
						and section.settings.enable_follow_on_shop
					-%}
						<div class='footer__follow-on-shop copyright__content focus-inset'>
							{% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
							{% # theme-check-disable %}
							{{ shop | login_button: action: 'follow' }}
							{% # theme-check-enable %}
						</div>
					{%- endif -%}
				</div>
			</div>
		</div>
	</footer>
{% endunless %}

